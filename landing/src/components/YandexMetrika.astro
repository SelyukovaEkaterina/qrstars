---
// Yandex.Metrika counter — included site-wide via Layout.astro
import {
  NO_ANALYTICS_COOKIE,
  NO_ANALYTICS_COOKIE_VALUE,
  NO_ANALYTICS_QUERY_PARAM,
} from '../lib/analytics-exclusion';
---

<script
  is:inline
  define:vars={{ NO_ANALYTICS_COOKIE, NO_ANALYTICS_COOKIE_VALUE, NO_ANALYTICS_QUERY_PARAM }}
>
  (function () {
    function isQaMode() {
      if (window.__QRSTARS_NO_ANALYTICS__ === true) return true;
      return document.cookie.split(';').some(function (part) {
        var bits = part.trim().split('=');
        return bits[0] === NO_ANALYTICS_COOKIE && bits.slice(1).join('=') === NO_ANALYTICS_COOKIE_VALUE;
      });
    }

    var qa = isQaMode();
    if (qa) {
      window.__QRSTARS_NO_ANALYTICS__ = true;
      window.ymGoal = function () {};
    } else {
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        (k = e.createElement(t)), (a = e.getElementsByTagName(t)[0]), (k.async = 1), (k.src = r), a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=109307713', 'ym');

      ym(109307713, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: 'dataLayer',
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });

      window.ymGoal = function (goal, params) {
        if (typeof ym === 'function') {
          ym(109307713, 'reachGoal', goal, params || {});
        }
      };

      (function firePageGoals() {
        var pageGoals = {
          '/free-qr-generator.html': 'qr_page_visit',
          '/qr-kod-dlya-video.html': 'qr_page_visit',
        };
        var goal = pageGoals[location.pathname];
        if (!goal) return;
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () {
            window.ymGoal(goal);
          });
        } else {
          window.ymGoal(goal);
        }
      })();

      document.addEventListener(
        'click',
        function (e) {
          var el = e.target && e.target.closest('[data-goal]');
          if (el) {
            var goal = el.getAttribute('data-goal');
            if (goal) {
              var rawParams = el.getAttribute('data-goal-params');
              var params = rawParams ? JSON.parse(rawParams) : undefined;
              window.ymGoal(goal, params);
            }
            return;
          }

          var link = e.target && e.target.closest('a[href*="free-qr-generator"]');
          if (link) window.ymGoal('qr_generator_link');
        },
        true,
      );
    }

    document.addEventListener(
      'click',
      function (e) {
        var a = e.target && e.target.closest('a[href*="app.qrstars.ru"]');
        if (!a) return;
        try {
          var url = new URL(a.href, location.origin);
          if (!qa) {
            var m = document.cookie.match(/(?:^|;\s*)_ym_uid=([^;]+)/);
            if (m && m[1] && !url.searchParams.has('_ym_uid')) {
              url.searchParams.set('_ym_uid', decodeURIComponent(m[1]).trim());
            }
            var qs = new URLSearchParams(location.search);
            ['yclid', 'ymclid'].forEach(function (k) {
              var v = qs.get(k);
              if (v && !url.searchParams.has(k)) url.searchParams.set(k, v);
            });
            var landingOverrideUtm = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term'];
            qs.forEach(function (value, key) {
              if (!key.startsWith('utm_')) return;
              var mayOverride = landingOverrideUtm.indexOf(key) !== -1;
              if (mayOverride || !url.searchParams.has(key)) url.searchParams.set(key, value);
            });
          }
          if (isQaMode() && !url.searchParams.has(NO_ANALYTICS_QUERY_PARAM)) {
            url.searchParams.set(NO_ANALYTICS_QUERY_PARAM, '1');
          }
          a.href = url.toString();
        } catch (_) {}
      },
      true,
    );
  })();
</script>
<noscript>
  <div><img src="https://mc.yandex.ru/watch/109307713" style="position:absolute; left:-9999px;" alt="" /></div>
</noscript>
