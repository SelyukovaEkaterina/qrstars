---
/**
 * «QrStars за минуту» на главной: обзорный ролик (videos/qrstars-overview, ускорен 1.25×).
 * Видео не грузится, пока не нажали ▶ (preload нет, вместо плеера — постер),
 * главы под плеером запускают ролик с нужного места.
 * Цели Метрики: home_video_play (`from`: poster | chapter), home_video_progress (`pct`: 50), home_video_complete.
 */
const SRC = '/video/qrstars-overview.mp4';
const POSTER = '/video/qrstars-overview-poster.webp';
const DURATION_S = 66;

const chapters = [
  { t: 4, label: 'Красивые QR', icon: 'fa-wand-magic-sparkles' },
  { t: 13, label: 'Анимация и 3D', icon: 'fa-cube' },
  { t: 22, label: 'Динамические коды', icon: 'fa-arrows-rotate' },
  { t: 31, label: 'QR-визитка', icon: 'fa-id-card' },
  { t: 40, label: 'QR-сайт', icon: 'fa-globe' },
  { t: 46, label: 'Отзывы', icon: 'fa-star' },
];

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'QrStars за минуту: красивые и динамические QR-коды, визитки, сайты и отзывы',
  description:
    'Обзор QrStars: арт-стили и анимация QR-кодов, динамические коды со сменой ссылки после печати, QR-визитка, QR-сайт и сбор отзывов на Яндекс Картах и 2ГИС.',
  thumbnailUrl: `https://qrstars.ru${POSTER}`,
  contentUrl: `https://qrstars.ru${SRC}`,
  uploadDate: '2026-11-17',
  duration: `PT1M${DURATION_S - 60}S`,
  inLanguage: 'ru',
  publisher: { '@type': 'Organization', name: 'QrStars', url: 'https://qrstars.ru' },
};
---

<section id="video" class="py-16 sm:py-20 bg-gradient-to-b from-white via-indigo-50/60 to-white relative overflow-hidden">
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center mb-8 sm:mb-10">
      <div class="inline-flex items-center gap-2 bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20">
        <i class="fa-solid fa-circle-play"></i>
        Видео · {fmt(DURATION_S)}
      </div>
      <h2 class="text-3xl font-bold mb-3">QrStars за минуту</h2>
      <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Красивые и анимированные коды, ссылка, которую можно поменять после печати, визитка, сайт и отзывы на картах. Всё, что умеет сервис, в одном коротком ролике.
      </p>
    </div>

    <div
      class="video-frame relative aspect-video rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-100 shadow-2xl shadow-indigo-500/20 ring-1 ring-slate-900/5"
      data-video-frame
    >
      <button
        type="button"
        class="group absolute inset-0 w-full h-full cursor-pointer"
        data-video-start="0"
        aria-label="Смотреть видео о QrStars"
      >
        <img
          src={POSTER}
          width="1280"
          height="720"
          alt="QrStars — умные QR-коды для бизнеса"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-[1.02]"
        />
        <span class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/10 transition"></span>
        <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
          <span class="absolute w-24 h-24 sm:w-28 sm:h-28 rounded-full bg-primary/25 animate-ping-slow"></span>
          <span class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-primary text-white flex items-center justify-center shadow-xl shadow-indigo-500/40 group-hover:scale-105 transition">
            <i class="fa-solid fa-play text-2xl sm:text-3xl ml-1.5"></i>
          </span>
        </span>
        <span class="absolute left-3 bottom-3 sm:left-5 sm:bottom-5 inline-flex items-center gap-2 bg-white/90 backdrop-blur text-slate-800 text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-full shadow">
          <i class="fa-solid fa-volume-high text-primary"></i>
          Со звуком · {fmt(DURATION_S)}
        </span>
      </button>
    </div>

    <div class="mt-5 sm:mt-6 flex flex-wrap justify-center gap-2 sm:gap-2.5">
      {chapters.map((c) => (
        <button
          type="button"
          data-video-start={c.t}
          class="inline-flex items-center gap-2 bg-white border border-slate-200 hover:border-primary/50 hover:text-primary text-slate-700 text-sm font-semibold pl-3 pr-3.5 py-2 rounded-full shadow-sm transition"
        >
          <i class={`fa-solid ${c.icon} text-primary text-xs`}></i>
          {c.label}
          <span class="text-slate-400 font-medium tabular-nums">{fmt(c.t)}</span>
        </button>
      ))}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
</section>

<style>
  @keyframes ping-slow {
    0% { transform: scale(0.85); opacity: 0.7; }
    80%, 100% { transform: scale(1.35); opacity: 0; }
  }
  .animate-ping-slow { animation: ping-slow 2.2s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @media (prefers-reduced-motion: reduce) {
    .animate-ping-slow { animation: none; }
  }
</style>

<script define:vars={{ SRC, POSTER }}>
  (function () {
    var frame = document.querySelector('[data-video-frame]');
    if (!frame) return;
    var video = null;
    var half = false;

    function goal(name, params) {
      if (typeof window.ymGoal === 'function') window.ymGoal(name, params);
    }

    function ensureVideo() {
      if (video) return video;
      video = document.createElement('video');
      video.src = SRC;
      video.poster = POSTER;
      video.controls = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.preload = 'auto';
      video.className = 'absolute inset-0 w-full h-full bg-slate-100';
      video.addEventListener('timeupdate', function () {
        if (!half && video.duration && video.currentTime / video.duration >= 0.5) {
          half = true;
          goal('home_video_progress', { pct: 50 });
        }
      });
      video.addEventListener('ended', function () {
        goal('home_video_complete');
      });
      frame.innerHTML = '';
      frame.appendChild(video);
      return video;
    }

    document.querySelectorAll('[data-video-start]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var t = Number(btn.getAttribute('data-video-start')) || 0;
        var fromPoster = frame.contains(btn);
        var v = ensureVideo();
        goal('home_video_play', { from: fromPoster ? 'poster' : 'chapter', t: t });
        var seek = function () {
          try { v.currentTime = t; } catch (e) {}
        };
        if (v.readyState >= 1) seek();
        else if (t > 0) v.addEventListener('loadedmetadata', seek, { once: true });
        // play() — синхронно в клике, иначе Safari на iOS не даст запустить со звуком
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
        if (!fromPoster) frame.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  })();
</script>
