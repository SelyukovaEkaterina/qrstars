---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import YandexMetrika from '../components/YandexMetrika.astro';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import {
  NO_ANALYTICS_COOKIE,
  NO_ANALYTICS_COOKIE_VALUE,
  NO_ANALYTICS_QUERY_PARAM,
  NO_ANALYTICS_COOKIE_MAX_AGE_SEC,
  NO_ANALYTICS_COOKIE_DOMAIN,
} from '../lib/analytics-exclusion';

interface Props {
  title: string;
  description?: string;
  /** If true, title is used as-is without appending " | QrStars" */
  fullTitle?: boolean;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Schema.org type for structured data. 'WebSite' on homepage, 'WebPage' elsewhere */
  pageType?: 'WebSite' | 'WebPage';
  yandexVerification?: string;
}

const {
  title,
  description = 'QR-экосистема для локального бизнеса. Динамические QR-коды для отзывов, меню, визиток и оплаты.',
  fullTitle = false,
  canonical,
  noindex = false,
  ogImage = 'https://qrstars.ru/og-default.jpg',
  yandexVerification,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | QrStars`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, 'https://qrstars.ru').href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://qrstars.ru/#organization',
      name: 'QrStars',
      alternateName: 'qrstars',
      url: 'https://qrstars.ru',
      logo: {
        '@type': 'ImageObject',
        url: 'https://qrstars.ru/favicon.svg',
      },
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://qrstars.ru/#website',
      url: 'https://qrstars.ru',
      name: 'QrStars',
      description: 'QR-экосистема для локального бизнеса',
      publisher: { '@id': 'https://qrstars.ru/#organization' },
      inLanguage: 'ru-RU',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-120.png" type="image/png" sizes="120x120" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon-120.png" sizes="120x120" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="QrStars" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Inter самохостится через @fontsource (импорт выше); иконки пока с CDN -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Глобальная структурированная разметка: Organization + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- QA mode: set cookie from ?no_analytics=1 before any Metrika scripts -->
    <script
      is:inline
      define:vars={{
        NO_ANALYTICS_QUERY_PARAM,
        NO_ANALYTICS_COOKIE,
        NO_ANALYTICS_COOKIE_VALUE,
        NO_ANALYTICS_COOKIE_MAX_AGE_SEC,
        NO_ANALYTICS_COOKIE_DOMAIN,
      }}
    >
      (function () {
        var params = new URLSearchParams(location.search);
        if (params.get(NO_ANALYTICS_QUERY_PARAM) === '1') {
          var host = location.hostname.toLowerCase();
          var useProdDomain = host === 'qrstars.ru' || host.endsWith('.qrstars.ru');
          var cookie =
            NO_ANALYTICS_COOKIE +
            '=' +
            NO_ANALYTICS_COOKIE_VALUE +
            ';path=/;max-age=' +
            NO_ANALYTICS_COOKIE_MAX_AGE_SEC +
            ';SameSite=Lax';
          if (useProdDomain) cookie += ';domain=' + NO_ANALYTICS_COOKIE_DOMAIN;
          document.cookie = cookie;
        }
        var disabled = document.cookie.split(';').some(function (part) {
          var bits = part.trim().split('=');
          return bits[0] === NO_ANALYTICS_COOKIE && bits.slice(1).join('=') === NO_ANALYTICS_COOKIE_VALUE;
        });
        if (disabled) window.__QRSTARS_NO_ANALYTICS__ = true;
      })();
    </script>
    <YandexMetrika />

    <!-- Прокидываем utm_*, yclid/ymclid, intent и ref со страницы в ссылки на кабинет (работает и без Метрики) -->
    <script is:inline>
      (function () {
        var REF_KEY = 'qrstars_ref';
        var REF_TTL_MS = 30 * 24 * 60 * 60 * 1000;
        // Реферальный код блогера (?ref=) запоминаем: человек может походить по сайту, прежде чем зарегистрироваться.
        function resolveRef(qs) {
          var fromUrl = (qs.get('ref') || '').trim();
          try {
            if (/^[A-Za-z0-9_-]{2,64}$/.test(fromUrl)) {
              localStorage.setItem(REF_KEY, JSON.stringify({ code: fromUrl, at: Date.now() }));
              return fromUrl;
            }
            var saved = JSON.parse(localStorage.getItem(REF_KEY) || 'null');
            if (saved && saved.code && Date.now() - saved.at < REF_TTL_MS) return saved.code;
          } catch (_) {}
          return '';
        }
        // Клик по рекламе (yclid/ymclid) запоминаем: человек уходит с посадочной на другие страницы,
        // а в ссылках там остались бы только внутренние метки CTA (qrstars / seo).
        var AD_KEY = 'qrstars_ad';
        var AD_PARAMS = ['yclid', 'ymclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        function resolveAdParams(qs) {
          try {
            if (qs.get('yclid') || qs.get('ymclid')) {
              var fresh = {};
              AD_PARAMS.forEach(function (k) {
                var v = qs.get(k);
                if (v) fresh[k] = v;
              });
              // В объявлениях Директа часто только yclid — источник проставляем сами.
              if (!fresh.utm_source) {
                fresh.utm_source = 'yandex';
                fresh.utm_medium = 'cpc';
              }
              localStorage.setItem(AD_KEY, JSON.stringify({ params: fresh, at: Date.now() }));
              return fresh;
            }
            var saved = JSON.parse(localStorage.getItem(AD_KEY) || 'null');
            if (saved && saved.params && Date.now() - saved.at < REF_TTL_MS) return saved.params;
          } catch (_) {}
          return null;
        }
        function run() {
          var qs = new URLSearchParams(location.search);
          var ref = resolveRef(qs);
          var hasOwnUtm = false;
          qs.forEach(function (_v, k) {
            if (k.indexOf('utm_') === 0) hasOwnUtm = true;
          });
          var ad = resolveAdParams(qs);
          // Рекламный клик важнее CTA-дефолтов; свежие utm_* в адресе (не реклама) — важнее сохранённого клика.
          if (ad && (!hasOwnUtm || qs.get('yclid') || qs.get('ymclid'))) {
            Object.keys(ad).forEach(function (k) {
              qs.set(k, ad[k]);
            });
          }
          var has = !!ref;
          qs.forEach(function (_v, k) {
            if (k.indexOf('utm_') === 0 || k === 'yclid' || k === 'ymclid' || k === 'intent') has = true;
          });
          if (!has) return;
          // Как в src/lib/utm.ts: source/medium/campaign/term с лендинга важнее дефолтов CTA, остальное не перезаписываем.
          var override = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term'];
          var links = document.querySelectorAll('a[href*="app.qrstars.ru"]');
          for (var i = 0; i < links.length; i++) {
            try {
              var url = new URL(links[i].href);
              var isRegister = url.pathname.indexOf('/register') === 0;
              qs.forEach(function (value, key) {
                if (key.indexOf('utm_') === 0) {
                  if (override.indexOf(key) !== -1 || !url.searchParams.has(key)) url.searchParams.set(key, value);
                } else if (key === 'yclid' || key === 'ymclid') {
                  if (!url.searchParams.has(key)) url.searchParams.set(key, value);
                } else if (key === 'intent') {
                  if (isRegister && !url.searchParams.has(key)) url.searchParams.set(key, value);
                }
              });
              if (ref && isRegister && !url.searchParams.has('ref')) url.searchParams.set('ref', ref);
              links[i].href = url.toString();
            } catch (_) {}
          }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
        else run();
      })();
    </script>

    <style is:global>
      .gradient-text {
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .feature-card:hover i {
        transform: scale(1.1);
        transition: transform 0.3s;
      }
      @tailwind base;
      @tailwind components;
      @tailwind utilities;
    </style>
  </head>
  <body class="font-sans text-slate-800 bg-slate-50 antialiased flex flex-col min-h-screen">
    <Nav />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
