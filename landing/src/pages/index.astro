  </section>

  <!-- ───────────── FAQ ───────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20">Вопросы и ответы</div>
        <h2 class="text-3xl font-bold mb-3">Частые вопросы</h2>
        <p class="text-slate-600 max-w-xl mx-auto">
          О тарифах, оплате по счёту, работе с филиалами и законе 152-ФЗ.
        </p>
      </div>
      <div class="space-y-3">
        {faq.map((item) => (
          <details class="group bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden open:border-primary/30 open:shadow-sm">
            <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 font-semibold text-slate-800 list-none hover:text-primary transition-colors">
              {item.q}
              <i class="fa-solid fa-chevron-down text-slate-400 text-sm transition-transform group-open:rotate-180 shrink-0"></i>
            </summary>
            <p class="px-6 pb-5 -mt-1 text-slate-600 text-sm leading-relaxed">{item.a}{item.link && (<> <a href={item.link.href} class="text-primary font-semibold hover:underline">{item.link.label}</a></>)}</p>
          </details>
        ))}
      </div>
      <div class="text-center mt-10">
        <p class="text-slate-500 text-sm mb-4">Остались вопросы? Попробуйте сервис бесплатно или напишите нам.</p>
        <a
          href={APP_URL}
          data-goal="faq_cta"
          class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3.5 rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/20"
        >
          Создать кабинет бесплатно
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <!-- ───────────── Финальный CTA ───────────── -->
  <section class="py-20 bg-gradient-to-br from-primary to-purple-600 text-white relative overflow-hidden">
    <div class="absolute -top-16 -right-16 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Сделайте первый динамический QR-код за пару минут
      </h2>
      <p class="text-indigo-100 text-lg mb-8 max-w-xl mx-auto leading-relaxed">
        Настройте сбор отзывов, электронную визитку, меню или ссылку, которую можно менять без перепечатки.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={APP_URL} data-goal="bottom_cta" class="bg-white text-primary px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-100 transition shadow-lg">
          Начать бесплатно
        </a>
        <a href="mailto:support@qrstars.ru" class="bg-white/10 border border-white/30 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition backdrop-blur-sm">
          Задать вопрос
        </a>
      </div>
    </div>
  </section>

</Layout>
