---
import Layout from '../layouts/Layout.astro';
import TryDemoSection from '../components/TryDemoSection.astro';
import QrGallery from '../components/QrGallery.astro';
import { registerUrl, withPlan } from '../lib/utm';

const APP_URL = registerUrl('home', Astro.url.searchParams);

const trustSignals = [
  { icon: 'fa-arrows-rotate', text: 'Смена ссылок онлайн без перепечатки' },
  { icon: 'fa-shield-halved', text: 'Серверы в РФ (152-ФЗ) · Безнал для юрлиц' },
  { icon: 'fa-map-location-dot', text: 'Маршрутизация на Яндекс Карты и 2ГИС' },
  { icon: 'fa-gift', text: 'Бесплатный тариф без ограничения по сроку' },
];

const steps = [
  {
    icon: 'fa-sliders',
    title: 'Настройте проект и сценарии',
    text: 'Выберите задачу: сбор отзывов на Яндекс Картах и 2ГИС, электронное меню, визитки или динамическая ссылка. Настройте фирменные цвета и загрузите логотип бренда.',
  },
  {
    icon: 'fa-qrcode',
    title: 'Разместите коды в локациях',
    text: 'Скачайте готовые коды в высоком разрешении PNG или векторном SVG. Печатайте наклейки, тейбл-тенты, бейджи или промо-материалы один раз на весь сезон.',
  },
  {
    icon: 'fa-chart-line',
    title: 'Управляйте и анализируйте в облаке',
    text: 'Обновляйте адреса и акции в кабинете за 10 секунд без перепечатки. Получайте жалобы до публикации на картах и отслеживайте статистику сканирований (сводка по филиалам — на тарифе «Сеть»).',
  },
];

const faq = [
  {
    q: 'Что такое динамический QR-код и зачем он нужен бизнесу?',
    a: 'В обычном статическом QR-коде ссылка зашита навсегда в рисунок: если адрес изменился — весь тираж наклеек, меню или баннеров летит в мусор. В динамическом коде ссылка проходит через облачную платформу QrStars. Вы можете менять адрес (сайт, акцию, меню, форму) в кабинете за 10 секунд без перепечатки полиграфии. При этом код считает сканирования на всех тарифах, а на PRO и «Сеть» — показывает детальную аналитику по дням, устройствам и филиалам.',
  },
  {
    q: 'Подходит ли QrStars для филиальной сети или франшизы?',
    a: 'Да. Тариф «Сеть» (2 900 ₽/год за 5 заведений) специально разработан для компаний с филиалами. Если точек больше пяти или нужны особые условия — напишите в техподдержку в личном кабинете или на support@qrstars.ru, подберём индивидуальный выгодный тариф. В едином кабинете объединяются все точки бренда: топ-менеджмент видит сводный дашборд с рейтингами филиалов, управляющие на местах работают только со своими отзывами, а аналитика легко выгружается в CSV.',
  },
  {
    q: 'Работаете ли вы с юрлицами по безналичному расчёту и через ЭДО?',
    a: 'Да, мы работаем с юридическими лицами и ИП по всей России: выставляем счета, отправляем закрывающие документы через ЭДО (Диадок, СБИС) или на бумаге. Сервис полностью соответствует требованиям 54-ФЗ.',
  },
  {
    q: 'Соответствует ли сервис требованиям 152-ФЗ о персональных данных?',
    a: 'Да. Все базы данных и серверная инфраструктура размещены на территории Российской Федерации. При сборе обратной связи и контактов гостей используется обязательное согласие на обработку персональных данных по 152-ФЗ.',
  },
  {
    q: 'Как работает модуль умных отзывов и перехват негатива?',
    a: 'Гость сканирует QR-код и выбирает оценку от 1 до 5 звёзд. Довольным клиентам (4–5★) предлагается оставить отзыв на Яндекс Картах, 2ГИС или Авито в один клик. При оценке 1–3★ гость оставляет обратную связь напрямую вам: обращение приходит управляющему на email (FREE) или мгновенно в Telegram и MAX (PRO), чтобы вы успели решить проблему до публикации на картах.',
  },
  {
    q: 'Что происходит с напечатанными материалами, если закончилась подписка?',
    a: 'QR-коды продолжают сканироваться, напечатанные материалы выбрасывать не нужно. Аккаунт переходит на FREE: микросайт остаётся опубликованным (правки оформления замораживаются), редиректы снова показывают экран QrStars на 3 секунды, уведомления о жалобах приходят на email вместо Telegram и MAX. Платные опции можно вернуть в любой момент, продлив подписку.',
  },
  {
    q: 'Можно ли настроить White Label и добавить свой логотип?',
    a: 'Да. В личном кабинете вы можете загрузить логотип компании в центр QR-кода, настроить фирменные цвета, а на тарифах PRO и «Сеть» — полностью убрать упоминания QrStars и использовать собственный брендинг.',
  },
  {
    q: 'Сколько сканирований включено и есть ли лимиты?',
    a: 'Количество сканирований не ограничено ни на одном тарифе. Мы не блокируем QR-коды при высоких нагрузках и росте посещаемости ваших заведений.',
  },
  {
    q: 'Чем бесплатный тариф FREE отличается от PRO?',
    a: 'FREE бесплатен навсегда: 1 проект, QR-кодов без лимита, сбор отзывов (4–5★ на Яндекс Карты, жалобы 1–3★ на email), меню, визитка, Wi‑Fi, файл и редирект, базовая статистика сканирований и средний рейтинг. Ограничения FREE: вотермарка QrStars и экран QrStars на 3 секунды перед редиректом. PRO (990 ₽/год) добавляет прямой переход без экрана, микросайт со всеми разделами в одном QR, ротацию площадок Яндекс / 2ГИС / Авито, жалобы в Telegram и MAX, White Label, промокод за отзыв 5★ и чаевые, расширенную аналитику по дням, устройствам и регионам.',
  },
  {
    q: 'Как проходит оплата, автосписание, отмена и возврат?',
    a: 'Платные тарифы оплачиваются банковской картой раз в год: PRO — 990 ₽, «Сеть» — 2 900 ₽. При оформлении вы отдельно соглашаетесь на автопродление; за несколько дней до списания приходит напоминание на email. Отменить подписку можно в любой момент в кабинете, раздел «Тариф и оплата» — платные функции сохранятся до конца оплаченного периода. Порядок возврата описан на странице «Условия оплаты и возврата».',
    link: { href: '/usloviya-oplaty-i-vozvrata.html', label: 'Условия оплаты и возврата →' },
  },
  {
    q: 'Где купить готовую табличку с QR-кодом?',
    a: 'Готовые акриловые таблички QrStars продаются на маркетплейсах Wildberries и Ozon — найдите их в поиске по названию «QrStars». Табличка не обязательна: QR-код можно создать бесплатно в кабинете, скачать в PNG или SVG и напечатать в любой типографии.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'QrStars',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  url: 'https://qrstars.ru',
  description: 'Платформа динамических QR-кодов: управление офлайн-точками, перехват негатива и сбор отзывов на Яндекс Картах и 2ГИС, смена ссылок без перепечатки полиграфии.',
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '2900',
    priceCurrency: 'RUB',
    offerCount: 3,
  },
};
---

<Layout
  title="QrStars — динамические QR-коды: отзывы на Яндекс Картах и 2ГИС, меню, визитки"
  fullTitle={true}
  description="Динамические QR-коды для бизнеса и специалистов: отзывы на Яндекс Картах и 2ГИС, электронное меню, визитки, файлы и видео. Ссылку можно менять после печати. Бесплатный тариф."
  yandexVerification="3dc4de0473e128f8"
>
  <!-- ───────────── Главный экран ───────────── -->
  <section class="pt-24 pb-12 sm:pt-32 sm:pb-16 lg:pt-40 lg:pb-20 overflow-hidden bg-white relative">
    <div
      class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <div
        class="hidden sm:inline-flex items-center gap-2 bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-6 border border-primary/20"
      >
        <i class="fa-solid fa-qrcode"></i>
        Динамические QR-коды для бизнеса и специалистов
      </div>
      <h1
        class="text-3xl md:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight leading-[1.1] mb-4 sm:mb-6 max-w-4xl mx-auto"
      >
        Динамические QR-коды для отзывов, меню и визиток:
        <span class="bg-gradient-to-r from-primary to-purple-500 gradient-text">
          ссылку можно менять после печати
        </span>
      </h1>
      <p class="sm:hidden text-base text-slate-600 mb-6 leading-relaxed">
        Отзывы на картах, меню, визитки и акции в одном QR. Меняйте ссылки без перепечатки.
      </p>
      <p class="hidden sm:block text-lg md:text-xl text-slate-600 mb-9 max-w-3xl mx-auto leading-relaxed">
        Объединяйте отзывы на картах, электронное меню, визитки и акции в одном QR-коде. Меняйте ссылки в облаке без перепечатки полиграфии, собирайте отзывы на Яндекс Картах и 2ГИС и смотрите, сколько раз отсканировали каждый код.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={APP_URL}
          data-goal="hero_start"
          class="bg-primary text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2"
        >
          <span>Начать бесплатно</span>
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
        <a
          href="#demo"
          data-goal="hero_demo"
          class="bg-white text-slate-700 border border-slate-200 px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-50 transition shadow-sm flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-mobile-screen-button text-primary"></i>
          <span>Смотреть демо</span>
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-500">
        Бесплатный тариф навсегда · Оплата по счёту для юрлиц (54-ФЗ) · Серверы в РФ (152-ФЗ) · Тарифы от 990 ₽/год
      </p>

      <ul
        class="mt-12 grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-3xl mx-auto text-left text-sm md:text-base text-slate-600"
      >
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">Экономия на полиграфии:</strong> меняйте ссылки, акции и меню за 10 секунд без перепечатки тиражей.</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">Защита репутации:</strong> поток отзывов 4–5★ на Яндекс Карты и 2ГИС, перехват жалоб 1–3★ до публикации (email на FREE · Telegram и MAX на PRO).</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">QR-визитка для мастеров и специалистов:</strong> звонок, WhatsApp, услуги с ценами и сохранение контакта — <a href="/qr-vizitka-mastera.html" class="text-primary hover:underline">бесплатно</a>.</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">White Label и свой бренд на PRO:</strong> прямой переход без промежуточных экранов и сторонних логотипов.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ───────────── Полоса доверия ───────────── -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        {trustSignals.map((s) => (
          <div class="flex items-center sm:justify-center gap-2.5 text-slate-600 text-sm font-medium">
            <i class={`fa-solid ${s.icon} text-primary`}></i>
            <span>{s.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────── Галерея красивых QR ───────────── -->
  <QrGallery />

  <!-- ───────────── Как работает динамика ───────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div
          class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20"
        >
          Преимущества динамических кодов
        </div>
        <h2 class="text-3xl font-bold mb-4 max-w-2xl mx-auto">
          Забудьте о повторной печати полиграфии при каждой смене акции
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed">
          В обычном QR-коде ссылка зашита намертво в рисунок: смена сайта, ошибка в адресе или новое меню требуют выбросить весь тираж. Динамический QR QrStars перенаправляет трафик через облачную платформу, позволяя обновить ссылку за секунды — напечатанный код продолжит работать.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-7">
          <div
            class="w-12 h-12 bg-rose-100 text-rose-500 rounded-xl flex items-center justify-center mb-4 text-xl"
          >
            <i class="fa-solid fa-xmark"></i>
          </div>
          <h3 class="font-bold text-lg mb-3">Обычный статический QR</h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Ссылка «зашита» намертво: сменился сайт или акция — перепечатывайте весь тираж</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Опечатка в адресе — и напечатанный тираж уходит в мусор</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Офлайн остаётся «чёрным ящиком»: нет данных о сканированиях и конверсиях</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Нельзя защитить рейтинг: недовольные гости сразу пишут негатив на картах</li>
          </ul>
        </div>
        <div class="bg-primary/5 border border-primary/20 rounded-2xl p-7">
          <div
            class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-4 text-xl"
          >
            <i class="fa-solid fa-check"></i>
          </div>
          <h3 class="font-bold text-lg mb-3">Динамический QR QrStars</h3>
          <ul class="space-y-2.5 text-sm text-slate-700">
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Адрес меняется в личном кабинете за 10 секунд без перепечатки материалов</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Напечатали на столах, стойках или баннерах один раз — и меняйте контент круглый год</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Статистика сканирований на всех тарифах; разрезы по дням и устройствам — на PRO, по филиалам — на «Сеть»</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Умные отзывы: 4–5★ на карты, а негатив 1–3★ — руководству (email на FREE · Telegram и MAX на PRO)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TryDemoSection />

  <!-- ───────────── Как это работает ───────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div
          class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20"
        >
          Быстрый старт
        </div>
        <h2 class="text-3xl font-bold mb-4">Как это работает</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Три простых шага от подключения до первых сканирований и отзывов — без сложных настроек и программистов.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 relative">
        {steps.map((step, i) => (
          <div class="bg-slate-50 border border-slate-100 rounded-2xl p-7 relative">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-12 h-12 bg-primary text-white rounded-xl flex items-center justify-center text-xl shrink-0"
              >
                <i class={`fa-solid ${step.icon}`}></i>
              </div>
              <span class="text-5xl font-extrabold text-slate-200">{i + 1}</span>
            </div>
            <h3 class="font-bold text-lg mb-2">{step.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href={APP_URL}
          data-goal="howto_register"
          class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3.5 rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/20"
        >
          Подключить заведение бесплатно
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────── Все возможности ───────────── -->
  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">Единая платформа для решения задач офлайн-бизнеса</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Все инструменты в одном кабинете: отзывы на картах, электронное меню, визитки, файлы и аналитика сканирований.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- 1. Умные отзывы (ХИТ) -->
        <a
          href="/smart-reviews.html"
          class="bg-white p-8 rounded-2xl border border-primary/20 shadow-sm hover:shadow-md transition feature-card group block relative"
        >
          <div class="absolute top-6 right-6 bg-primary/10 text-primary text-xs font-bold px-2.5 py-1 rounded-full">Хит</div>
          <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-star text-2xl text-amber-500 group-hover:scale-110 transition"></i>
          </div>
