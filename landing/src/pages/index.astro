---
import Layout from '../layouts/Layout.astro';
import TryDemoSection from '../components/TryDemoSection.astro';
import { registerUrl } from '../lib/utm';

const APP_URL = registerUrl('home', Astro.url.searchParams);

const trustSignals = [
  { icon: 'fa-arrows-rotate', text: 'Смена ссылок онлайн без перепечатки' },
  { icon: 'fa-shield-halved', text: 'Серверы в РФ (152-ФЗ) · Безнал для юрлиц' },
  { icon: 'fa-map-location-dot', text: 'Маршрутизация на Яндекс Карты и 2ГИС' },
  { icon: 'fa-network-wired', text: 'Сводный дашборд и роли для филиалов' },
];

const steps = [
  {
    icon: 'fa-sliders',
    title: '1. Настройте проект и сценарии',
    text: 'Выберите задачу: сбор отзывов на Яндекс Картах и 2ГИС, электронное меню, визитки или динамическая ссылка. Настройте фирменные цвета и загрузите логотип бренда.',
  },
  {
    icon: 'fa-qrcode',
    title: '2. Разместите коды в локациях',
    text: 'Скачайте готовые коды в высоком разрешении PNG или векторном SVG. Печатайте наклейки, тейбл-тенты, бейджи или промо-материалы один раз на весь сезон.',
  },
  {
    icon: 'fa-chart-line',
    title: '3. Управляйте и анализируйте в облаке',
    text: 'Обновляйте адреса и акции в кабинете за 10 секунд без перепечатки. Получайте жалобы до публикации на картах и отслеживайте статистику по филиалам.',
  },
];

const faq = [
  {
    q: 'Что такое динамический QR-код и зачем он нужен бизнесу?',
    a: 'В обычном статическом QR-коде ссылка зашита навсегда в рисунок: если адрес изменился — весь тираж наклеек, меню или баннеров летит в мусор. В динамическом коде ссылка проходит через облачную платформу QrStars. Вы можете менять адрес (сайт, акцию, меню, форму) в кабинете за 10 секунд без перепечатки полиграфии. При этом код собирает подробную аналитику сканирований по филиалам и устройствам.',
  },
  {
    q: 'Подходит ли QrStars для филиальной сети или франшизы?',
    a: 'Да. Тариф «Сеть» (от 600 ₽/мес за 2 заведения, +150 ₽/мес за каждую точку сверх двух) специально разработан для компаний с филиалами. В едином кабинете объединяются все точки бренда: топ-менеджмент видит сводный дашборд с рейтингами филиалов, управляющие на местах работают только со своими отзывами, а аналитика легко выгружается в CSV.',
  },
  {
    q: 'Работаете ли вы с юрлицами по безналичному расчёту и через ЭДО?',
    a: 'Да, мы работаем с юридическими лицами и ИП по всей России: выставляем счета, отправляем закрывающие документы через ЭДО (Диадок, СБИС) или на бумаге. Сервис полностью соответствует требованиям 54-ФЗ.',
  },
  {
    q: 'Соответствует ли сервис требованиям 152-ФЗ о персональных данных?',
    a: 'Да. Все базы данных и серверная инфраструктура размещены на территории Российской Федерации. При сборе обратной связи и контактов гостей используется обязательное согласие на обработку персональных данных по 152-ФЗ.',
  },
  {
    q: 'Как работает модуль умных отзывов и перехват негатива?',
    a: 'Гость сканирует QR-код и выбирает оценку от 1 до 5 звёзд. Довольным клиентам (4–5★) предлагается оставить отзыв на Яндекс Картах, 2ГИС или Авито в один клик. При оценке 1–3★ гость оставляет обратную связь напрямую вам: обращение мгновенно приходит управляющему в Telegram или на email, чтобы вы успели решить проблему до публикации на картах.',
  },
  {
    q: 'Что происходит с напечатанными материалами, если закончилась подписка?',
    a: 'Все созданные QR-коды продолжают работать! Ссылки и редиректы не ломаются, офлайн-трафик не теряется. На бесплатном тарифе сохраняются базовые функции перенаправления, а расширенные опции (White Label, Telegram-уведомления) можно возобновить в любой момент.',
  },
  {
    q: 'Можно ли настроить White Label и добавить свой логотип?',
    a: 'Да. В личном кабинете вы можете загрузить логотип компании в центр QR-кода, настроить фирменные цвета, а на тарифах PRO и «Сеть» — полностью убрать упоминания QrStars и использовать собственный брендинг.',
  },
  {
    q: 'Сколько сканирований включено и есть ли лимиты?',
    a: 'Количество сканирований не ограничено ни на одном тарифе. Мы не блокируем QR-коды при высоких нагрузках и росте посещаемости ваших заведений.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'QrStars',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'All',
  url: 'https://qrstars.ru',
  description: 'Платформа динамических QR-кодов: управление офлайн-точками, перехват негатива и сбор отзывов на Яндекс Картах и 2ГИС, смена ссылок без перепечатки полиграфии.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB',
  },
};
---

<Layout
  title="QrStars — платформа динамических QR-кодов и умных отзывов для бизнеса и сетей"
  fullTitle={true}
  description="Платформа динамических QR-кодов для заведений, сетей и ритейла. Управление офлайн-точками, защита рейтинга на Яндекс Картах и 2ГИС, смена контента без перепечатки полиграфии. Попробуйте бесплатно."
  yandexVerification="3dc4de0473e128f8"
>
  <!-- ───────────── Главный экран ───────────── -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden bg-white relative">
    <div
      class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
      <div
        class="inline-flex items-center gap-2 bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-6 border border-primary/20"
      >
        <i class="fa-solid fa-qrcode"></i>
        Платформа динамических QR-кодов и умных отзывов для бизнеса и сетей
      </div>
      <h1
        class="text-3xl md:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto"
      >
        Динамические QR-коды и умные отзывы:
        <span class="bg-gradient-to-r from-primary to-purple-500 gradient-text">
          управляйте репутацией и офлайн-трафиком
        </span>
      </h1>
      <p class="text-lg md:text-xl text-slate-600 mb-9 max-w-3xl mx-auto leading-relaxed">
        Объединяйте отзывы на картах, электронное меню, визитки и акции в одном QR-коде. Меняйте ссылки в облаке без перепечатки полиграфии, защищайте рейтинг заведений и контролируйте все филиалы из единого кабинета.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={APP_URL}
          data-goal="hero_start"
          class="bg-primary text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/30 flex items-center justify-center gap-2"
        >
          <span>Начать бесплатно</span>
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
        <a
          href="#demo"
          data-goal="hero_demo"
          class="bg-white text-slate-700 border border-slate-200 px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-50 transition shadow-sm flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-mobile-screen-button text-primary"></i>
          <span>Смотреть демо</span>
        </a>
      </div>
      <p class="mt-4 text-sm text-slate-500">
        Бесплатный тариф навсегда · Оплата по счёту для юрлиц (54-ФЗ) · Серверы в РФ (152-ФЗ) · Тарифы от 990 ₽/год
      </p>

      <ul
        class="mt-12 grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-3xl mx-auto text-left text-sm md:text-base text-slate-600"
      >
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">Экономия на полиграфии:</strong> меняйте ссылки, акции и меню за 10 секунд без перепечатки тиражей.</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">Защита репутации:</strong> поток отзывов 4–5★ на Яндекс Карты и 2ГИС, перехват жалоб 1–3★ до публикации.</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">Единое управление сетью:</strong> сводный дашборд филиалов, роли для управляющих и сквозная аналитика.</span>
        </li>
        <li class="flex items-start gap-3">
          <i class="fa-solid fa-circle-check text-primary mt-1 shrink-0"></i>
          <span><strong class="text-slate-800">White Label и свой бренд:</strong> прямой переход без промежуточных экранов и сторонних логотипов.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ───────────── Полоса доверия ───────────── -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {trustSignals.map((s) => (
          <div class="flex items-center justify-center gap-2.5 text-slate-600 text-sm font-medium">
            <i class={`fa-solid ${s.icon} text-primary`}></i>
            <span>{s.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────────── Как работает динамика ───────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div
          class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20"
        >
          Преимущества динамических кодов
        </div>
        <h2 class="text-3xl font-bold mb-4 max-w-2xl mx-auto">
          Забудьте о повторной печати полиграфии при каждой смене акции
        </h2>
        <p class="text-slate-600 max-w-2xl mx-auto leading-relaxed">
          В обычном QR-коде ссылка зашита намертво в рисунок: смена сайта, ошибка в адресе или новое меню требуют выбросить весь тираж. Динамический QR QrStars перенаправляет трафик через облачную платформу, позволяя мгновенно обновлять ссылки во всей сети филиалов.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-7">
          <div
            class="w-12 h-12 bg-rose-100 text-rose-500 rounded-xl flex items-center justify-center mb-4 text-xl"
          >
            <i class="fa-solid fa-xmark"></i>
          </div>
          <h3 class="font-bold text-lg mb-3">Обычный статический QR</h3>
          <ul class="space-y-2.5 text-sm text-slate-600">
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Ссылка «зашита» намертво: сменился сайт или акция — перепечатывайте тираж во всей сети</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Опечатка в адресе блокирует работу филиалов и приводит к убыткам</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Офлайн остаётся «чёрным ящиком»: нет данных о сканированиях и конверсиях</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-xmark text-rose-400 mt-1 shrink-0"></i> Нельзя защитить рейтинг: недовольные гости сразу пишут негатив на картах</li>
          </ul>
        </div>
        <div class="bg-primary/5 border border-primary/20 rounded-2xl p-7">
          <div
            class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-4 text-xl"
          >
            <i class="fa-solid fa-check"></i>
          </div>
          <h3 class="font-bold text-lg mb-3">Динамический QR QrStars</h3>
          <ul class="space-y-2.5 text-sm text-slate-700">
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Адрес меняется в личном кабинете за 10 секунд без перепечатки материалов</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Напечатали на столах, стойках или баннерах один раз — и меняйте контент круглый год</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Сквозная статистика по каждой точке, дням недели и типам устройств</li>
            <li class="flex gap-2.5"><i class="fa-solid fa-check text-primary mt-1 shrink-0"></i> Умные отзывы: 4–5★ на карты, а негатив 1–3★ — сразу руководству в Telegram</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TryDemoSection />

  <!-- ───────────── Результаты внедрения ───────────── -->
  <section class="py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold mb-4">Результаты внедрения в филиальных сетях</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Автоматизация сбора обратной связи, защита рейтинга филиалов и сокращение операционных расходов на офлайн-маркетинг.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm relative">
          <div class="text-primary mb-4 text-3xl"><i class="fa-solid fa-chart-line"></i></div>
          <div class="text-2xl font-extrabold text-slate-900 mb-1">+0.6 балла</div>
          <h3 class="font-bold text-lg mb-2">Рост на Яндекс Картах и 2ГИС</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Поток оценок 4–5★ от лояльных гостей направляется на карты, поднимая филиалы в локальной выдаче и привлекая новых клиентов без доплат за платное продвижение.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm relative">
          <div class="text-primary mb-4 text-3xl"><i class="fa-solid fa-shield-halved"></i></div>
          <div class="text-2xl font-extrabold text-slate-900 mb-1">85% перехвата</div>
          <h3 class="font-bold text-lg mb-2">Защита репутации до публикации</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Жалобы 1–3★ моментально поступают управляющим точек в Telegram и на почту. Вы успеваете урегулировать инцидент на месте, пока гость не опубликовал негатив в интернете.
          </p>
        </div>

        <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm relative">
          <div class="text-primary mb-4 text-3xl"><i class="fa-solid fa-coins"></i></div>
          <div class="text-2xl font-extrabold text-slate-900 mb-1">До 70% экономии</div>
          <h3 class="font-bold text-lg mb-2">Сокращение расходов на полиграфию</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Больше не нужно заклеивать цены или выбрасывать сотни тейбл-тентов, меню и баннеров из-за смены промо-акции. Весь контент обновляется в облаке за пару секунд.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Как это работает ───────────── -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div
          class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm mb-4 border border-primary/20"
        >
          Быстрый старт
        </div>
        <h2 class="text-3xl font-bold mb-4">Как это работает</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Три простых шага от подключения до первых сканирований и отзывов — без сложных настроек и программистов.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 relative">
        {steps.map((step, i) => (
          <div class="bg-slate-50 border border-slate-100 rounded-2xl p-7 relative">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-12 h-12 bg-primary text-white rounded-xl flex items-center justify-center text-xl shrink-0"
              >
                <i class={`fa-solid ${step.icon}`}></i>
              </div>
              <span class="text-5xl font-extrabold text-slate-200">{i + 1}</span>
            </div>
            <h3 class="font-bold text-lg mb-2">{step.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href={APP_URL}
          data-goal="howto_register"
          class="inline-flex items-center gap-2 bg-primary text-white px-8 py-3.5 rounded-xl font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/20"
        >
          Подключить заведение бесплатно
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────── Все возможности ───────────── -->
  <section id="features" class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">Единая платформа для решения задач офлайн-бизнеса</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Все инструменты в одном кабинете: от сбора отзывов на картах и электронного меню до управления сетью филиалов.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- 1. Умные отзывы (ХИТ) -->
        <a
          href="/smart-reviews.html"
          class="bg-white p-8 rounded-2xl border border-primary/20 shadow-sm hover:shadow-md transition feature-card group block relative"
        >
          <div class="absolute top-6 right-6 bg-primary/10 text-primary text-xs font-bold px-2.5 py-1 rounded-full">Хит</div>
          <div class="w-14 h-14 bg-amber-100 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-star text-2xl text-amber-500 group-hover:scale-110 transition"></i>
          </div>
          <h3 class="font-bold text-xl mb-3">Умные отзывы на картах</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Растите в рейтинге Яндекс Карт и 2ГИС. Перенаправляйте довольных клиентов на карты, а негатив принимайте лично в Telegram, чтобы исправить ситуацию до публикации.
          </p>
