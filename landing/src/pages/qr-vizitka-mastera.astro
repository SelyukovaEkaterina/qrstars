---
import Layout from '../layouts/Layout.astro';
import DemoQrScan from '../components/DemoQrScan.astro';
import { cardRegisterUrl } from '../lib/utm';

const DEMO_SCAN_URL = 'https://app.qrstars.ru/q/demo-master';
const HERO_CTA_URL = cardRegisterUrl('master_hero', Astro.url.searchParams, 'master_card');
const BOTTOM_CTA_URL = cardRegisterUrl('master_bottom', Astro.url.searchParams, 'master_card');

const places = [
  { icon: 'fa-bolt', title: 'Электрощиток', text: 'Рядом с автоматами — первое место, куда смотрят, когда выбило свет.' },
  { icon: 'fa-fire-flame-simple', title: 'Котёл и бойлер', text: 'Через год нужно обслуживание — клиент сканирует и звонит вам.' },
  { icon: 'fa-faucet-drip', title: 'Под раковиной и у счётчиков', text: 'Потекло — номер мастера уже на месте, искать не нужно.' },
  { icon: 'fa-receipt', title: 'Чек и гарантийный талон', text: 'QR на бумагах после работы: клиент сохранит ваш контакт.' },
  { icon: 'fa-car', title: 'Машина и ящик с инструментом', text: 'Соседи и прохожие сканируют и сразу видят ваши услуги и цены.' },
  { icon: 'fa-comment-dots', title: 'Ссылка в мессенджере', text: 'После заказа отправьте ссылку в WhatsApp — номер не потеряется.' },
];

const features = [
  { icon: 'fa-phone', title: 'Позвонить в один тап', text: 'Большая кнопка звонка, WhatsApp, Telegram и MAX.' },
  { icon: 'fa-address-book', title: 'Сохранить контакт', text: 'Ваш номер сразу попадает в телефонную книгу клиента — на iPhone и Android.' },
  { icon: 'fa-list-check', title: 'Услуги и цены', text: '«Установка розетки — от 400 ₽». Клиент знает, сколько стоит, ещё до звонка.' },
  { icon: 'fa-location-dot', title: 'Район и часы работы', text: 'Сразу понятно, приедете ли вы и когда можно звонить.' },
  { icon: 'fa-star', title: 'Отзывы обо мне', text: 'Кнопка на ваш профиль на Авито, Профи или Яндекс Картах.' },
  { icon: 'fa-paper-plane', title: 'Заявки', text: 'Клиент описывает задачу и оставляет телефон — заявка приходит вам на почту или в Telegram.' },
];

const faq = [
  {
    q: 'Сколько это стоит?',
    a: 'Визитка и QR-код бесплатны, без ограничения по сроку. Внизу визитки будет небольшая подпись QrStars — убрать её можно на тарифе PRO.',
  },
  {
    q: 'Нужен ли сайт или знания компьютера?',
    a: 'Нет. Всё делается с телефона: вводите имя, профессию и номер — визитка готова. Фото и цены добавите потом, когда будет время.',
  },
  {
    q: 'Если поменяю номер, придётся перепечатывать наклейки?',
    a: 'Нет. QR-код ведёт на вашу визитку, а данные в ней вы меняете в личном кабинете. Напечатанные наклейки продолжат работать.',
  },
  {
    q: 'Как напечатать наклейки?',
    a: 'Скачайте QR-код в PNG или SVG и отдайте в любую типографию или копицентр. Подойдут виниловые наклейки или магниты размером от 3×3 см.',
  },
  {
    q: 'Клиент увидит рекламу других мастеров?',
    a: 'Нет. На визитке только ваши контакты и услуги — никаких конкурентов, как на сайтах объявлений.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="QR-визитка для мастера: электрика, сантехника, мастера на час"
  description="Бесплатная QR-визитка для мастера: клиент сканирует наклейку на щитке или котле и сразу звонит вам или пишет в WhatsApp. Услуги и цены, сохранение контакта, заявки. Сделать за минуту с телефона."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="pt-24 pb-16 sm:pt-32 lg:pt-40 lg:pb-20 overflow-hidden bg-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="z-10">
          <div class="flex flex-wrap items-center gap-2 mb-6">
            <div class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-sm border border-primary/20">
              🔧 Для электриков, сантехников и мастеров на час
            </div>
            <div class="inline-block bg-green-100 text-green-800 font-semibold px-3 py-1.5 rounded-full text-xs border border-green-200">
              Бесплатно
            </div>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight mb-6">
            Клиент позвонит <span class="text-primary">вам</span>, а не будет искать нового мастера
          </h1>
          <p class="text-lg md:text-xl text-slate-600 mb-8 max-w-lg leading-relaxed">
            Оставьте наклейку с QR-кодом на щитке, котле или в чеке. Через полгода клиент отсканирует её — и сразу позвонит, напишет в WhatsApp или сохранит ваш номер.
          </p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3"><i class="fa-solid fa-check-circle text-green-500 mt-1"></i> <span class="text-slate-700 font-medium">Готово за минуту с телефона: имя, профессия, номер</span></li>
            <li class="flex items-start gap-3"><i class="fa-solid fa-check-circle text-green-500 mt-1"></i> <span class="text-slate-700 font-medium">Кнопки «Позвонить», WhatsApp и Telegram</span></li>
            <li class="flex items-start gap-3"><i class="fa-solid fa-check-circle text-green-500 mt-1"></i> <span class="text-slate-700 font-medium">Услуги с ценами, район выезда, отзывы о вас</span></li>
            <li class="flex items-start gap-3"><i class="fa-solid fa-check-circle text-green-500 mt-1"></i> <span class="text-slate-700 font-medium">Поменяли номер — наклейки перепечатывать не нужно</span></li>
          </ul>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={HERO_CTA_URL} data-goal="hero_start" class="inline-flex items-center justify-center bg-primary text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/30">
              Сделать визитку бесплатно
            </a>
            <a href={DEMO_SCAN_URL} target="_blank" rel="noopener" class="inline-flex items-center justify-center bg-slate-100 text-slate-800 px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-200 transition">
              Посмотреть пример
            </a>
          </div>
        </div>

        <div class="relative flex justify-center" aria-hidden="true">
          <div class="w-[300px] rounded-[2.5rem] border-[10px] border-slate-900 bg-white shadow-2xl overflow-hidden">
            <div class="h-20 bg-gradient-to-br from-sky-700 to-sky-500 relative">
              <div class="absolute -bottom-9 left-1/2 -translate-x-1/2 w-[4.5rem] h-[4.5rem] rounded-full border-4 border-white bg-sky-700 text-white font-bold text-xl flex items-center justify-center">СП</div>
            </div>
            <div class="pt-11 px-5 pb-5 text-center">
              <div class="font-bold text-slate-900">Сергей Петров</div>
              <div class="text-sm text-slate-500">Электрик</div>
              <div class="mt-2 text-xs text-slate-500"><i class="fa-solid fa-location-dot mr-1"></i>Москва, выезд по городу</div>
              <div class="mt-4 rounded-xl bg-sky-700 text-white font-semibold py-2.5 text-sm"><i class="fa-solid fa-phone mr-1"></i> Позвонить</div>
              <div class="mt-2 grid grid-cols-2 gap-2 text-sm font-semibold text-white">
                <div class="rounded-xl py-2.5" style="background:#25D366">WhatsApp</div>
                <div class="rounded-xl py-2.5" style="background:#229ED9">Telegram</div>
              </div>
              <div class="mt-4 text-left text-xs font-semibold text-slate-900">Услуги и цены</div>
              <div class="mt-1 rounded-xl border border-slate-200 divide-y divide-slate-100 text-left text-xs">
                <div class="flex justify-between px-3 py-2"><span>Установка розетки</span><b>от 400 ₽</b></div>
                <div class="flex justify-between px-3 py-2"><span>Замена автомата</span><b>от 600 ₽</b></div>
                <div class="flex justify-between px-3 py-2"><span>Сборка щитка</span><b>от 3 500 ₽</b></div>
              </div>
              <div class="mt-3 rounded-xl bg-sky-700 text-white font-medium py-2.5 text-sm">💾 Сохранить контакт</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Где оставить QR-код</h2>
        <p class="text-slate-600">Бумажную визитку теряют на следующий день. Наклейка остаётся там, где вы работали, и приводит повторные заказы.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {places.map((p) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
            <div class="w-10 h-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center mb-4">
              <i class={`fa-solid ${p.icon}`}></i>
            </div>
            <h3 class="font-bold text-lg mb-2">{p.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold mb-4">Что увидит клиент</h2>
        <p class="text-slate-600">Одна страница, на которой всё, чтобы сразу с вами связаться.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((f) => (
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 shrink-0 bg-green-100 text-green-700 rounded-lg flex items-center justify-center">
              <i class={`fa-solid ${f.icon}`}></i>
            </div>
            <div>
              <h3 class="font-bold mb-1">{f.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{f.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <DemoQrScan
    scanUrl={DEMO_SCAN_URL}
    modeLabel="Визитка мастера"
    title="Отсканируйте пример визитки"
    subtitle="Так визитку увидит ваш клиент: звонок, мессенджеры, услуги с ценами и сохранение контакта"
  />

  <section class="py-16 lg:py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-12 text-center">Три шага — и визитка готова</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <div class="w-10 h-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center font-bold mb-4">1</div>
          <h3 class="font-bold text-lg mb-2">Регистрация</h3>
          <p class="text-slate-600 text-sm leading-relaxed">По email или в один тап через VK или Яндекс.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <div class="w-10 h-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center font-bold mb-4">2</div>
          <h3 class="font-bold text-lg mb-2">Имя, профессия, телефон</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Визитка и QR-код появятся сразу. Фото и цены можно добавить позже.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
          <div class="w-10 h-10 bg-primary/10 text-primary rounded-lg flex items-center justify-center font-bold mb-4">3</div>
          <h3 class="font-bold text-lg mb-2">Наклейки</h3>
          <p class="text-slate-600 text-sm leading-relaxed">Скачайте QR-код и закажите наклейки в любой типографии. Или просто отправляйте ссылку клиентам.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-10 text-center">Частые вопросы</h2>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900">
              {item.q}
              <i class="fa-solid fa-chevron-down text-slate-400 transition group-open:rotate-180"></i>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Сделайте визитку сейчас — это бесплатно</h2>
      <p class="text-slate-600 mb-8">Минута на заполнение. Наклейки с QR-кодом работают годами и приводят повторные заказы.</p>
      <a href={BOTTOM_CTA_URL} data-goal="bottom_cta" class="inline-flex items-center justify-center bg-primary text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 transition shadow-lg shadow-indigo-500/30">
        Сделать визитку бесплатно
      </a>
    </div>
  </section>
</Layout>
