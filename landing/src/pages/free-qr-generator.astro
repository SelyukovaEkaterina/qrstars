    const show = (el: HTMLElement, visible: boolean) => el.classList.toggle('hidden', !visible);

    // ── Logo images ───────────────────────────────────────
    function emojiToImage(emoji: string): HTMLImageElement {
        const size = 200;
        const c = document.createElement('canvas');
        c.width = size;
        c.height = size;
        const ectx = c.getContext('2d')!;
        ectx.font = `${size * 0.7}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
        ectx.textAlign = 'center';
        ectx.textBaseline = 'middle';
        ectx.fillText(emoji, size / 2, size / 2);
        const img = new Image();
        img.src = c.toDataURL();
        return img;
    }

    const logoCache = new Map<number, Promise<HTMLImageElement>>();
    /** Картинка пресета, уже готовая к drawImage (иначе первый кадр рисуется без логотипа). */
    function loadLogoPreset(idx: number): Promise<HTMLImageElement> {
        let p = logoCache.get(idx);
        if (!p) {
            const preset = LOGO_PRESETS[idx];
            const img = preset.emoji ? emojiToImage(preset.emoji) : new Image();
            if (preset.src) img.src = preset.src;
            p = img.decode().then(() => img).catch(() => img);
            logoCache.set(idx, p);
        }
        return p;
    }

    async function selectLogoPreset(idx: number | null) {
        if (idx === null) {
            state.logoImage = null;
            state.logoKey = null;
        } else {
            state.logoImage = await loadLogoPreset(idx);
            state.logoKey = idx;
            state.centerMode = 'image';
            if (state.ecc === 'L' || state.ecc === 'M') state.ecc = 'H';
        }
        input('input-logo').value = '';
        $('logo-label').textContent = 'Загрузить свой';
        syncUiFromState();
        scheduleUpdate();
    }

    function renderLogoPresets() {
        const container = $('logo-presets');
        const none = document.createElement('button');
        none.type = 'button';
        none.className = 'logo-preset-btn';
        none.dataset.logo = 'none';
        none.title = 'Без логотипа';
        none.setAttribute('aria-label', 'Без логотипа');
        none.innerHTML = '<i class="fa-solid fa-ban text-slate-400"></i>';
        Object.assign(none.style, { background: '#f8fafc', fontSize: '1.1rem' });
        none.addEventListener('click', () => selectLogoPreset(null));
        container.appendChild(none);

        LOGO_PRESETS.forEach((p, i) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'logo-preset-btn';
            btn.dataset.logo = String(i);
            btn.title = p.name;
            btn.setAttribute('aria-label', p.name);
            if (p.emoji) {
                btn.textContent = p.emoji;
                Object.assign(btn.style, { fontSize: '1.4rem', lineHeight: '1', background: '#f8fafc' });
            } else {
                Object.assign(btn.style, {
                    backgroundImage: `url(${p.src})`,
                    backgroundSize: 'contain',
                    backgroundPosition: 'center',
                    backgroundRepeat: 'no-repeat',
                    backgroundColor: '#f8fafc',
                });
            }
            btn.addEventListener('click', () => selectLogoPreset(i));
            container.appendChild(btn);
        });
        const more = document.createElement('button');
        more.type = 'button';
        more.id = 'btn-logo-more';
        more.className = 'logo-preset-btn logo-more-btn';
        more.addEventListener('click', () => {
            logosExpanded = true;
            syncLogoCollapse();
        });
        container.appendChild(more);
        desktopLogos.addEventListener('change', syncLogoCollapse);
    }

    /** На десктопе сначала два ряда логотипов: 47 эмодзи занимали пол-экрана. */
    const LOGOS_COLLAPSED = 19;
    let logosExpanded = false;
    const desktopLogos = window.matchMedia('(min-width: 1024px)');
    function syncLogoCollapse() {
        const collapse = !logosExpanded && desktopLogos.matches;
        const btns = [...document.querySelectorAll<HTMLElement>('.logo-preset-btn:not(.logo-more-btn)')];
        btns.forEach((b, i) => {
            // Выбранный логотип не прячем.
            b.hidden = collapse && i >= LOGOS_COLLAPSED && !b.classList.contains('is-active');
        });
        const more = $('btn-logo-more');
        const hiddenCount = btns.filter(b => b.hidden).length;
        more.textContent = `+${hiddenCount}`;
        more.title = 'Показать все логотипы';
        more.setAttribute('aria-label', 'Показать все логотипы');
        more.hidden = !collapse || hiddenCount === 0;
    }

    function renderPhotoPresets() {
        const container = $('photo-presets');
        PHOTO_PRESETS.forEach((p, i) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'photo-preset-btn';
            btn.dataset.photo = String(i);
            btn.title = p.name;
            btn.setAttribute('aria-label', p.name);
            Object.assign(btn.style, {
                backgroundImage: `url(${p.src})`,
                backgroundSize: 'cover',
                backgroundPosition: 'center',
            });
            btn.addEventListener('click', () => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => {
                    state.photoImage = img;
                    state.photoKey = i;
                    $('photo-label').textContent = 'Загрузить своё';
                    syncPhotoUi();
                    scheduleUpdate();
                };
                img.src = p.src;
            });
            container.appendChild(btn);
        });
    }

    function loadPhotoPreset(i: number): Promise<HTMLImageElement> {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = () => resolve(img);
            img.onerror = reject;
            img.src = PHOTO_PRESETS[i].src;
        });
    }

    /** Логотип стиля: эмодзи из списка или `qrstars` — номер в LOGO_PRESETS, -1 — без логотипа. */
    const artLogoIndex = (logo: string | undefined) =>
        !logo ? -1 : LOGO_PRESETS.findIndex(p => (logo === 'qrstars' ? p.src === '/logo.svg' : p.emoji === logo));
    const photoIndexBySrc = (src: string) => PHOTO_PRESETS.findIndex(p => p.src === src);

    function artPresetFields(p: ArtPreset): Partial<typeof state> {
        return { ...ART_RESET, ...artPresetDesign(p) } as Partial<typeof state>;
    }

    let artCategory: ArtPresetCategory | 'all' = 'all';
    /** На десктопе «Все» сначала показывают два ряда: 33 карточки выталкивали настройки за экран. */
    const ART_COLLAPSED = 12;
    let artExpanded = false;
    const desktopArt = window.matchMedia('(min-width: 1024px)');

    function renderArtCategories() {
        const row = $('art-categories');
        const make = (id: ArtPresetCategory | 'all', label: string) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'art-cat-btn';
            btn.dataset.cat = id;
            btn.textContent = label;
            btn.addEventListener('click', () => {
                artCategory = id;
                syncArtCategories();
                goal(METRIKA_GOALS.qrArtCategory, { category: id });
            });
            row.appendChild(btn);
        };
        make('all', 'Все');
        $('btn-art-more').addEventListener('click', () => {
            artExpanded = true;
            syncArtCategories();
        });
        desktopArt.addEventListener('change', syncArtCategories);
        ART_PRESET_CATEGORIES.forEach(c => make(c.id, c.label));
        syncArtCategories();
    }

    function syncArtCategories() {
        document.querySelectorAll<HTMLElement>('.art-cat-btn').forEach(b => b.classList.toggle('is-active', b.dataset.cat === artCategory));
        const collapse = artCategory === 'all' && !artExpanded && desktopArt.matches;
        let shown = 0;
        document.querySelectorAll<HTMLElement>('.art-preset-btn').forEach(b => {
            const inCat = artCategory === 'all' || b.dataset.cat === artCategory;
            // Выбранный стиль не прячем, даже если он за пределами двух рядов.
            b.hidden = !inCat || (collapse && shown >= ART_COLLAPSED && !b.classList.contains('is-active'));
            if (inCat) shown++;
        });
        const more = $('btn-art-more');
        more.textContent = `Показать все стили (${ART_PRESETS.length})`;
        show(more, collapse && shown > ART_COLLAPSED);
        $('art-presets').scrollLeft = 0;
    }

    function renderArtPresets() {
        const container = $('art-presets');
        const thumbs: { canvas: HTMLCanvasElement; preset: ArtPreset }[] = [];
        ART_PRESETS.forEach((p, i) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'art-preset-btn';
            btn.dataset.art = String(i);
            btn.dataset.cat = p.category;
            btn.title = p.description;
            const box = document.createElement('span');
            box.className = 'art-thumb';
            const thumb = document.createElement('canvas');
            box.appendChild(thumb);
            const label = document.createElement('span');
            label.className = 'art-label';
            label.textContent = p.name;
            btn.append(box, label);
            btn.addEventListener('click', () => {
                applyArtPreset(i);
                document.querySelectorAll('.art-preset-btn').forEach(b => b.classList.toggle('is-active', b === btn));
                goal(METRIKA_GOALS.qrArtPreset, { preset: p.id });
            });
            container.appendChild(btn);
            thumbs.push({ canvas: thumb, preset: p });
        });

        // Миниатюры — тем же движком, по одной в свободное время: 30+ отрисовок разом подвешивали страницу.
        const renderThumb = async ({ canvas: thumb, preset: p }: (typeof thumbs)[number]) => {
            const idx = artLogoIndex(p.logo);
            const [logo, photo] = await Promise.all([
                idx >= 0 ? loadLogoPreset(idx) : Promise.resolve(null),
                p.photo ? loadPhotoPreset(photoIndexBySrc(p.photo)).catch(() => null) : Promise.resolve(null),
            ]);
            const d = { ...state, ...artPresetFields(p) };
            const modules = QRCode.create('https://qrstars.ru', { errorCorrectionLevel: d.ecc }).modules as unknown as QrModules;
            const assets: QrAssets = { logo, photo };
            renderToCanvas(thumb, computeLayout(modules, d, assets), d, assets, 136);
        };
        const idle = (cb: () => void) => ('requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 500 }) : window.setTimeout(cb, 16));
        const next = () => {
            const item = thumbs.shift();
            if (!item) return;
            renderThumb(item).catch(() => {}).finally(() => idle(next));
        };
        idle(next);
    }

    async function applyArtPreset(i: number) {
        const p = ART_PRESETS[i];
        Object.assign(state, artPresetFields(p));
        state.centerTextColor = state.fg;
        // Свой загруженный логотип не трогаем — человек его уже выбрал.
        if (state.logoKey !== 'upload') {
            const idx = artLogoIndex(p.logo);
            state.logoImage = idx >= 0 ? await loadLogoPreset(idx) : null;
            state.logoKey = idx >= 0 ? idx : null;
        }
        if (p.photo) {
            if (!state.photoImage) {
                const idx = photoIndexBySrc(p.photo);
                state.photoImage = await loadPhotoPreset(idx);
                state.photoKey = idx;
            }
        } else if (state.photoKey !== 'upload') {
            state.photoImage = null;
            state.photoKey = null;
        }
        clearColorPresetMark();
        syncUiFromState();
        scheduleUpdate();
    }

    function renderColorPresets() {
        const presetPicker = $('preset-picker');
        PRESETS.forEach((p, i) => {
            const btn = document.createElement('button');
            btn.className = 'preset-btn';
            btn.dataset.idx = String(i);
            btn.type = 'button';
            btn.title = p.name;
            btn.setAttribute('aria-label', p.name);
            if (p.gradient) {
                const angle = p.gradType === 'linear-tb' ? '180deg' : p.gradType === 'linear-lr' ? '90deg' : '135deg';
                btn.style.background = p.gradType === 'radial'
                    ? `radial-gradient(circle, ${p.grad1}, ${p.grad2})`
                    : `linear-gradient(${angle}, ${p.grad1}, ${p.grad2})`;
            } else {
                btn.style.background = p.fg!;
            }
            if (p.bg !== '#ffffff') btn.style.boxShadow = `inset 0 0 0 5px ${p.bg}`;
            btn.addEventListener('click', () => {
                applyPreset(i);
                document.querySelectorAll('.preset-btn').forEach(b => b.classList.toggle('is-active', b === btn));
            });
            presetPicker.appendChild(btn);
        });
    }

    function applyPreset(i: number) {
        const p = PRESETS[i];
        state.gradient = p.gradient;
        if (p.gradient) {
            state.grad1 = p.grad1!;
            state.grad2 = p.grad2!;
            state.gradType = p.gradType!;
        } else {
            state.fg = p.fg!;
        }
        state.bg = p.bg;
        state.bgTransparent = false;
        syncUiFromState();
        scheduleUpdate();
    }

    // ── UI ⇄ state ────────────────────────────────────────
    function syncLogoUi() {
        document.querySelectorAll<HTMLElement>('.logo-preset-btn').forEach(b => {
            const key = b.dataset.logo === 'none' ? null : Number(b.dataset.logo);
            b.classList.toggle('is-active', state.logoKey !== 'upload' && key === state.logoKey);
        });
        syncLogoCollapse();
        const textMode = state.centerMode === 'text';
        const summary = textMode ? (centerLines()[0] || 'текст')
            : state.logoKey === null ? 'нет'
            : state.logoKey === 'upload' ? 'свой файл'
            : LOGO_PRESETS[state.logoKey].emoji ?? LOGO_PRESETS[state.logoKey].name;
        $('logo-summary').textContent = summary;
        document.querySelectorAll<HTMLButtonElement>('.center-mode-btn').forEach(b => {
            const active = b.dataset.centerMode === state.centerMode;
            b.classList.toggle('active-tab', active);
            b.setAttribute('aria-pressed', String(active));
        });
        show($('center-image-controls'), !textMode);
        show($('center-text-controls'), textMode);
        $('logo-fill-label').textContent = textMode ? 'Точки под надписью' : 'Точки под логотипом';
        const lines = state.centerText.split('\n');
        for (let i = 0; i < 3; i++) input(`input-center-line-${i}`).value = lines[i] ?? '';
        ($('input-center-font') as HTMLSelectElement).value = state.centerTextFont;
        input('input-center-color').value = state.centerTextColor;
        input('input-center-bold').checked = state.centerTextBold;
    }

    function centerLines(): string[] {
        return state.centerText.split('\n').map(l => l.trim()).filter(Boolean);
    }

    // ── Текст в центре ───────────────────────────────────
    const centerFontSelect = $('input-center-font') as HTMLSelectElement;
    CENTER_TEXT_FONTS.forEach(f => centerFontSelect.add(new Option(f.label, f.id)));
    document.querySelectorAll<HTMLButtonElement>('.center-mode-btn').forEach(btn => btn.addEventListener('click', () => {
        state.centerMode = btn.dataset.centerMode as 'image' | 'text';
        // Надпись закрывает центр кода так же, как логотип.
        if (state.centerMode === 'text') state.ecc = 'H';
        syncUiFromState();
        scheduleUpdate();
    }));
    for (let i = 0; i < 3; i++) {
        input(`input-center-line-${i}`).addEventListener('input', () => {
            state.centerText = [0, 1, 2].map(j => input(`input-center-line-${j}`).value).join('\n').replace(/\n+$/, '');
            $('logo-summary').textContent = centerLines()[0] || 'текст';
            scheduleUpdate();
        });
    }
    centerFontSelect.addEventListener('change', () => { state.centerTextFont = centerFontSelect.value as QrCenterTextFont; scheduleUpdate(); });
    input('input-center-color').addEventListener('input', e => { state.centerTextColor = (e.target as HTMLInputElement).value; scheduleUpdate(); });
    input('input-center-bold').addEventListener('change', e => { state.centerTextBold = (e.target as HTMLInputElement).checked; scheduleUpdate(); });

    function syncPhotoUi() {
        document.querySelectorAll<HTMLElement>('.photo-preset-btn').forEach(b => {
            b.classList.toggle('is-active', state.photoKey !== 'upload' && Number(b.dataset.photo) === state.photoKey);
        });
        show($('btn-photo-clear'), !!state.photoImage);
        $('photo-summary').textContent = !state.photoImage ? 'нет'
            : state.photoKey === 'upload' ? 'своё фото'
            : PHOTO_PRESETS[state.photoKey as number].name;
    }

    function codeShapeMode(): 'none' | 'figure' | 'pattern' {
        return state.silhouette !== 'none' ? 'figure' : state.scatter ? 'pattern' : 'none';
    }

    function switchTabUi(type: QrType) {
        tabs.forEach(t => {
            const active = t.dataset.type === type;
            t.classList.toggle('active-tab', active);
