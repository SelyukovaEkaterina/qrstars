    /** Все контролы оформления — из state. Используется пресетами, «Случайным» и ссылкой с #hash. */
    function syncUiFromState() {
        switchTabUi(state.type);
        styleBtns.forEach(b => b.classList.toggle('active-style', b.dataset.style === state.dotStyle));
        $('shape-summary').textContent = (document.querySelector<HTMLElement>(`.style-btn[data-style="${state.dotStyle}"] .thumb-label`)?.textContent ?? '').toLowerCase();
        eyeBtns.forEach(b => b.classList.toggle('active-eye', b.dataset.eye === state.eyeStyle));
        input('input-fg').value = state.fg;
        input('input-fg-text').value = state.fg;
        input('input-bg').value = state.bg;
        input('input-bg-text').value = state.bg;
        const transparentBtn = $('btn-bg-transparent');
        transparentBtn.classList.toggle('!bg-primary', state.bgTransparent);
        transparentBtn.classList.toggle('!text-white', state.bgTransparent);
        transparentBtn.setAttribute('aria-pressed', String(state.bgTransparent));

        input('input-gradient').checked = state.gradient;
        show($('gradient-controls'), state.gradient);
        input('input-grad1').value = state.grad1;
        input('input-grad2').value = state.grad2;
        ($('input-grad-type') as HTMLSelectElement).value = state.gradType;

        input('input-eye-custom').checked = state.eyeCustom;
        show($('eye-color-controls'), state.eyeCustom);
        input('input-eye-color').value = state.eyeColor;

        input('input-logo-size').value = String(state.logoSize);
        input('input-logo-fill').checked = state.logoFill;
        syncLogoUi();
        syncPhotoUi();

        input('input-frame').checked = state.frame;
        show($('frame-controls'), state.frame);
        input('input-frame-text').value = state.frameText;
        ($('input-frame-style') as HTMLSelectElement).value = state.frameStyle;
        $('frame-summary').textContent = state.frame ? state.frameText : 'нет';

        document.querySelectorAll<HTMLButtonElement>('.photo-style-btn').forEach(b => {
            const active = b.dataset.photoStyle === state.photoStyle;
            b.classList.toggle('active-tab', active);
            b.setAttribute('aria-pressed', String(active));
        });
        $('photo-style-hint').textContent = state.photoStyle === 'halftone'
            ? 'Фото превращается в точечную гравюру, модули встают точками в центр клетки. Лучше всего — предмет на светлом фоне.'
            : 'Фото становится фоном, поверх — полупрозрачные модули. Проверяйте предупреждения о сканировании.';
        // «Форма кода»: фигура важнее узора — движок с силуэтом узор не рисует.
        const codeShape = codeShapeMode();
        document.querySelectorAll<HTMLButtonElement>('.code-shape-btn').forEach(b => {
            const active = b.dataset.codeShape === codeShape;
            b.classList.toggle('active-tab', active);
            b.setAttribute('aria-pressed', String(active));
        });
        show($('sil-controls'), codeShape === 'figure');
        show($('scatter-controls'), codeShape === 'pattern');
        document.querySelectorAll<HTMLElement>('.sil-btn').forEach(b => b.classList.toggle('is-active', b.dataset.sil === state.silhouette));
        input('input-sil-fit').value = String(state.silhouetteFit);
        input('input-rotate45').checked = state.rotate45;
        input('input-ink-shift').checked = state.inkShift;
        input('input-scatter-size').value = String(state.scatterDensity);
        sshapeBtns.forEach(b => b.classList.toggle('is-active', b.dataset.sshape === state.scatterShape));
        const shapeLabel = codeShape === 'figure'
            ? (state.silhouette === 'custom' ? 'своя фигура' : QR_SILHOUETTES.find(f => f.id === state.silhouette)?.label.toLowerCase())
            : codeShape === 'pattern'
                ? `узор: ${(document.querySelector<HTMLElement>(`.sshape-btn[data-sshape="${state.scatterShape}"]`)?.textContent ?? '').toLowerCase()}`
                : 'квадрат';
        $('artshape-summary').textContent = [shapeLabel, state.rotate45 ? 'ромб' : null, state.inkShift ? 'CMYK' : null].filter(Boolean).join(', ');

        ($('input-ecc') as HTMLSelectElement).value = state.ecc;
        input('input-margin').value = String(state.margin);
        ($('input-export-size') as HTMLSelectElement).value = String(state.exportSize);
        ($('input-export-size-dialog') as HTMLSelectElement).value = String(state.exportSize);
    }

    // ── Tabs ──────────────────────────────────────────────
    function switchTab(type: QrType) {
        if (state.type === type) return;
        state.type = type;
        switchTabUi(type);
        goal(METRIKA_GOALS.qrTypeChange, { qr_type: type });
        scheduleUpdate();
    }
    tabs.forEach(tab => tab.addEventListener('click', () => {
        switchTab(tab.dataset.type as QrType);
        tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    }));

    // ── Style controls ────────────────────────────────────
    styleBtns.forEach(btn => btn.addEventListener('click', () => {
        state.dotStyle = btn.dataset.style as DotStyle;
        syncUiFromState();
        scheduleUpdate();
    }));
    eyeBtns.forEach(btn => btn.addEventListener('click', () => {
        state.eyeStyle = btn.dataset.eye as EyeStyle;
        syncUiFromState();
        scheduleUpdate();
    }));

    function clearColorPresetMark() {
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('is-active'));
    }

    function syncColorPair(colorEl: HTMLInputElement, textEl: HTMLInputElement, key: 'fg' | 'bg') {
        colorEl.addEventListener('input', () => {
            textEl.value = colorEl.value;
            state[key] = colorEl.value;
            if (key === 'bg') state.bgTransparent = false;
            if (key === 'fg') state.gradient = false;
            clearColorPresetMark();
            syncUiFromState();
            scheduleUpdate();
        });
        textEl.addEventListener('change', () => {
            let v = textEl.value.trim();
            if (/^[0-9a-fA-F]{6}$/.test(v)) v = `#${v}`;
            if (/^#[0-9a-fA-F]{6}$/.test(v)) {
                state[key] = v.toLowerCase();
                if (key === 'bg') state.bgTransparent = false;
                if (key === 'fg') state.gradient = false;
                clearColorPresetMark();
                scheduleUpdate();
            }
            syncUiFromState();
        });
    }
    syncColorPair(input('input-fg'), input('input-fg-text'), 'fg');
    syncColorPair(input('input-bg'), input('input-bg-text'), 'bg');

    $('btn-bg-transparent').addEventListener('click', () => {
        state.bgTransparent = !state.bgTransparent;
        syncUiFromState();
        scheduleUpdate();
    });

    input('input-gradient').addEventListener('change', e => {
        state.gradient = (e.target as HTMLInputElement).checked;
        clearColorPresetMark();
        syncUiFromState();
        scheduleUpdate();
    });
    input('input-grad1').addEventListener('input', e => { state.grad1 = (e.target as HTMLInputElement).value; clearColorPresetMark(); scheduleUpdate(); });
    input('input-grad2').addEventListener('input', e => { state.grad2 = (e.target as HTMLInputElement).value; clearColorPresetMark(); scheduleUpdate(); });
    ($('input-grad-type') as HTMLSelectElement).addEventListener('change', e => { state.gradType = (e.target as HTMLSelectElement).value as GradType; scheduleUpdate(); });

    input('input-eye-custom').addEventListener('change', e => {
        state.eyeCustom = (e.target as HTMLInputElement).checked;
        syncUiFromState();
        scheduleUpdate();
    });
    input('input-eye-color').addEventListener('input', e => { state.eyeColor = (e.target as HTMLInputElement).value; scheduleUpdate(); });

    function readImageFile(file: File, cb: (img: HTMLImageElement) => void) {
        const reader = new FileReader();
        reader.onload = ev => {
            const img = new Image();
            img.onload = () => cb(img);
            img.src = ev.target?.result as string;
        };
        reader.readAsDataURL(file);
    }
    const shortName = (name: string) => (name.length > 18 ? name.slice(0, 16) + '…' : name);

    input('input-logo').addEventListener('change', e => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        readImageFile(file, img => {
            state.logoImage = img;
            state.logoKey = 'upload';
            state.centerMode = 'image';
            // Свой логотип перекрывает центр — держим максимальную коррекцию ошибок.
            state.ecc = 'H';
            $('logo-label').textContent = shortName(file.name);
            syncUiFromState();
            goal(METRIKA_GOALS.qrLogoUpload);
            scheduleUpdate();
        });
    });
    input('input-logo-size').addEventListener('input', e => {
        state.logoSize = parseInt((e.target as HTMLInputElement).value, 10);
        scheduleUpdate();
    });
    input('input-logo-fill').addEventListener('change', e => {
        state.logoFill = (e.target as HTMLInputElement).checked;
        scheduleUpdate();
    });

    input('input-photo').addEventListener('change', e => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        readImageFile(file, img => {
            state.photoImage = img;
            state.photoKey = 'upload';
            $('photo-label').textContent = shortName(file.name);
            syncPhotoUi();
            goal(METRIKA_GOALS.qrPhotoUpload);
            scheduleUpdate();
        });
    });
    $('btn-photo-clear').addEventListener('click', () => {
        state.photoImage = null;
        state.photoKey = null;
        input('input-photo').value = '';
        $('photo-label').textContent = 'Загрузить своё';
        syncPhotoUi();
        scheduleUpdate();
    });

    input('input-frame').addEventListener('change', e => {
        state.frame = (e.target as HTMLInputElement).checked;
        syncUiFromState();
        scheduleUpdate();
    });
    input('input-frame-text').addEventListener('input', e => {
        state.frameText = (e.target as HTMLInputElement).value || 'СКАНИРУЙ МЕНЯ';
        $('frame-summary').textContent = state.frameText;
        scheduleUpdate();
    });
    ($('input-frame-style') as HTMLSelectElement).addEventListener('change', e => {
        state.frameStyle = (e.target as HTMLSelectElement).value as FrameStyle;
        scheduleUpdate();
    });

    input('input-scatter-size').addEventListener('input', e => {
        state.scatterDensity = parseInt((e.target as HTMLInputElement).value, 10);
        scheduleUpdate();
    });
    sshapeBtns.forEach(btn => btn.addEventListener('click', () => {
        state.scatterShape = btn.dataset.sshape as ScatterShape;
        syncUiFromState();
        scheduleUpdate();
    }));

    // ── Арт-форма и фото-гравюра ─────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.photo-style-btn').forEach(btn => btn.addEventListener('click', () => {
        state.photoStyle = btn.dataset.photoStyle as PhotoStyle;
        syncUiFromState();
        scheduleUpdate();
    }));
    // Сетка фигур — миниатюрами силуэтов из движка; «Своя» (загрузка) уже стоит в разметке последней.
    const silGrid = $('sil-grid');
    QR_SILHOUETTES.forEach(f => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'sil-btn';
        btn.dataset.sil = f.id;
        btn.title = f.label;
        btn.setAttribute('aria-label', f.label);
        const icon = document.createElement('canvas');
        icon.width = 56;
        icon.height = 56;
        renderSilhouettePreview(icon, f.id);
        const name = document.createElement('span');
        name.className = 'sil-name';
        name.textContent = f.label;
        btn.append(icon, name);
        btn.addEventListener('click', () => selectSilhouette(f.id));
        silGrid.insertBefore(btn, silGrid.lastElementChild);
    });

    /** Последняя выбранная фигура — к ней возвращает режим «Фигура». */
    let lastSilhouette: QrSilhouette = 'heart';
    function selectSilhouette(id: QrSilhouette) {
        state.silhouette = id;
        if (id !== 'none') {
            lastSilhouette = id;
            state.scatter = false;
            state.margin = Math.min(state.margin, 2);
        }
        syncUiFromState();
        scheduleUpdate();
    }

    document.querySelectorAll<HTMLButtonElement>('.code-shape-btn').forEach(btn => btn.addEventListener('click', () => {
        const mode = btn.dataset.codeShape as 'none' | 'figure' | 'pattern';
        if (mode === 'figure') {
            selectSilhouette(lastSilhouette === 'custom' && !state.silhouetteImage ? 'heart' : lastSilhouette);
            return;
        }
        // Фигура могла прийти из арт-стиля или ссылки, а не кликом — запоминаем её при уходе из режима.
        if (state.silhouette !== 'none') lastSilhouette = state.silhouette;
        state.silhouette = 'none';
        state.scatter = mode === 'pattern';
        syncUiFromState();
        scheduleUpdate();
    }));
    input('input-silhouette').addEventListener('change', e => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        readImageFile(file, img => {
            state.silhouetteImage = img;
            state.silhouette = 'custom';
            lastSilhouette = 'custom';
            state.scatter = false;
            state.margin = Math.min(state.margin, 2);
            $('sil-label').closest('label')?.setAttribute('title', file.name);
            syncUiFromState();
            scheduleUpdate();
        });
    });
    input('input-sil-fit').addEventListener('input', e => {
        state.silhouetteFit = parseInt((e.target as HTMLInputElement).value, 10);
        scheduleUpdate();
    });
    input('input-rotate45').addEventListener('change', e => {
        state.rotate45 = (e.target as HTMLInputElement).checked;
        syncUiFromState();
        scheduleUpdate();
    });
    input('input-ink-shift').addEventListener('change', e => {
        state.inkShift = (e.target as HTMLInputElement).checked;
        syncUiFromState();
        scheduleUpdate();
    });

    ($('input-ecc') as HTMLSelectElement).addEventListener('change', e => {
        state.ecc = (e.target as HTMLSelectElement).value as Ecc;
        scheduleUpdate();
    });
    input('input-margin').addEventListener('input', e => {
        state.margin = parseInt((e.target as HTMLInputElement).value, 10);
        scheduleUpdate();
    });

    for (const id of ['input-export-size', 'input-export-size-dialog']) {
        ($(id) as HTMLSelectElement).addEventListener('change', e => {
            state.exportSize = Number((e.target as HTMLSelectElement).value) || 1200;
            syncUiFromState();
            saveToHash();
        });
    }

    // Любое действие в блоке оформления — дизайн «свой», его стоит перенести в кабинет.
    for (const ev of ['input', 'change', 'click']) {
        $('qr-styles').addEventListener(ev, e => {
            if ((e.target as HTMLElement).closest('input, select, button')) designTouched = true;
        });
    }

    // ── Отрисовка (общий движок src/lib/qr-engine) ───────
    styleCanvases.forEach((c, i) => renderDotStylePreview(c, DOT_STYLES[i]));
    eyeCanvases.forEach((c, i) => renderEyeStylePreview(c, EYE_STYLES[i]));

    let current: QrLayout | null = null;

    const TOO_MUCH_DATA = 'Слишком много данных для одного QR — сократите текст или поставьте уровень коррекции L в «Дополнительно».';

    function qrAssets(): QrAssets {
        return {
            logo: state.centerMode === 'text' ? null : state.logoImage,
            photo: state.photoImage,
            silhouette: state.silhouette === 'custom' ? state.silhouetteImage : null,
        };
    }

    function computeQrLayout(payload: string): QrLayout {
        const modules = QRCode.create(payload, { errorCorrectionLevel: state.ecc }).modules as unknown as QrModules;
        return computeLayout(modules, state, qrAssets());
    }

    function setDownloadsEnabled(enabled: boolean) {
        downloadBtns.forEach(b => (b.disabled = !enabled));
        btnMoreMobile.disabled = !enabled;
    }

    function showInputMessage(kind: 'error' | 'hint' | null, text = '') {
        show(inputMsg, !!kind);
        inputMsg.className = `mt-3 text-sm leading-relaxed ${kind === 'error' ? 'text-red-600' : 'text-slate-500'}${kind ? '' : ' hidden'}`;
        inputMsg.innerHTML = kind
            ? `<i class="fa-solid ${kind === 'error' ? 'fa-circle-exclamation' : 'fa-circle-info text-primary/70'} mr-1"></i>`
            : '';
        if (kind) inputMsg.append(text);
    }

    function clearPreview(text?: string) {
        current = null;
        canvas.classList.add('hidden');
        placeholder.classList.remove('hidden');
        placeholderText.textContent = text ?? 'Введите данные — код появится сразу';
        setDownloadsEnabled(false);
        $('qr-readability-warning').classList.add('hidden');
        renderScanAlerts('ok');
    }

    function generate() {
        const res = buildPayload(state.type, fieldValue);
        if (res.kind === 'empty') {
            showInputMessage(null);
            clearPreview();
            return;
        }
        if (res.kind === 'error') {
            showInputMessage('error', res.message);
            clearPreview('Исправьте данные — и код появится');
            return;
        }
        let L: QrLayout;
        try {
            L = computeQrLayout(res.payload);
        } catch {
            showInputMessage('error', TOO_MUCH_DATA);
            clearPreview('Слишком много данных');
            return;
        }
        showInputMessage(res.hint ? 'hint' : null, res.hint ?? '');
        current = L;

        canvas.width = Math.ceil(L.canvasW);
        canvas.height = Math.ceil(L.canvasH);
        const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
        drawQr(ctx, L, state, qrAssets());

        canvas.classList.remove('hidden');
        placeholder.classList.add('hidden');
        setDownloadsEnabled(true);

        // Фото-режим: средний контраст тёмных и светлых модулей поверх фото.
        const warningEl = $('qr-readability-warning');
        if (state.photoImage && state.photoStyle === 'overlay' && !L.rotated) {
            const rendered = ctx.getImageData(L.qrLeft, L.qrTop, L.qrSize, L.qrSize);
            let darkLum = 0, lightLum = 0, darkN = 0, lightN = 0;
            for (let row = 0; row < L.count; row++) {
                for (let col = 0; col < L.count; col++) {
                    if (isInFinder(row, col, L.count)) continue;
                    const px = Math.floor(L.offX - L.qrLeft + (col + 0.5) * L.cellSize);
                    const py = Math.floor(L.offY - L.qrTop + (row + 0.5) * L.cellSize);
                    const idx = (py * L.qrSize + px) * 4;
                    const lum = 0.2126 * rendered.data[idx] + 0.7152 * rendered.data[idx + 1] + 0.0722 * rendered.data[idx + 2];
                    if (L.modules.data[row * L.count + col]) { darkLum += lum; darkN++; }
                    else { lightLum += lum; lightN++; }
                }
            }
            const avgDark = darkN ? darkLum / darkN : 0;
            const avgLight = lightN ? lightLum / lightN : 255;
            warningEl.classList.toggle('hidden', (Math.max(avgDark, avgLight) - Math.min(avgDark, avgLight)) / 255 >= 0.25);
        } else {
            warningEl.classList.add('hidden');
        }

        scheduleScanCheck();
        trackGenerate();
        updateMockTitles();
        if (dialog.open) refreshDialogImages();
    }

    let updateTimer: number | null = null;
    function scheduleUpdate() {
        saveToHash();
        if (updateTimer) window.clearTimeout(updateTimer);
        updateTimer = window.setTimeout(() => { updateTimer = null; generate(); }, 120);
    }
    function generateNow() {
        if (updateTimer) window.clearTimeout(updateTimer);
        updateTimer = null;
        generate();
    }

    // ── Goals ─────────────────────────────────────────────
    let userEditedData = false;
    const generatedTypes = new Set<QrType>();
    let generateGoalTimer: number | null = null;
    /** `qr_generate` — один раз на тип, когда пользователь ввёл свои данные и код собрался. */
    function trackGenerate() {
        if (!userEditedData || generatedTypes.has(state.type)) return;
        if (generateGoalTimer) window.clearTimeout(generateGoalTimer);
        const type = state.type;
        generateGoalTimer = window.setTimeout(() => {
            if (!current || state.type !== type) return;
            generatedTypes.add(type);
            goal(METRIKA_GOALS.qrGenerate, { qr_type: type });
        }, 1500);
    }

    // ── Readability check (real jsQR decode, в фоне) ─────
    type ScanLevel = 'ok' | 'print' | 'screen';

    function checkScanLevel(): ScanLevel {
        return current ? checkQrScanLevel(canvas, current, jsQR) : 'ok';
    }

    const SCAN_TEXT: Record<Exclude<ScanLevel, 'ok'>, { icon: string; text: string }> = {
        screen: { icon: 'fa-desktop', text: 'QR-код может плохо сканироваться: добавьте контраста, уменьшите логотип или уберите фото. Проверьте камерой телефона перед печатью.' },
        print: { icon: 'fa-print', text: 'Код может хуже читаться при печати мелко или на старых телефонах. Проверьте его камерой перед тиражом.' },
    };
    let lastScanLevel: ScanLevel = 'ok';

    function renderScanAlerts(level: ScanLevel) {
        for (const id of ['qr-scan-alerts', 'qr-dialog-alerts']) {
            const container = $(id);
            container.replaceChildren();
            show(container, level !== 'ok');
            if (level === 'ok') continue;
            const row = document.createElement('div');
            row.className = 'flex items-start gap-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-800 leading-relaxed';
            row.innerHTML = `<i class="fa-solid ${SCAN_TEXT[level].icon} mt-0.5 shrink-0 text-amber-500"></i>`;
            const span = document.createElement('span');
            span.textContent = SCAN_TEXT[level].text;
            row.appendChild(span);
            container.appendChild(row);
        }
        show($('qr-scan-badge'), level !== 'ok');
        if (level !== 'ok' && level !== lastScanLevel) goal(METRIKA_GOALS.qrScanWarning, { level, qr_type: state.type });
        lastScanLevel = level;
    }

    let scanTimer: number | null = null;
    function scheduleScanCheck() {
        if (scanTimer) window.clearTimeout(scanTimer);
        // jsQR — до 10 декодирований: ждём паузы во вводе и свободного кадра.
        scanTimer = window.setTimeout(() => {
            const run = () => renderScanAlerts(checkScanLevel());
            if ('requestIdleCallback' in window) window.requestIdleCallback(run, { timeout: 800 });
            else run();
        }, 400);
    }

    // ── Export ────────────────────────────────────────────
    function renderScaled(width: number): HTMLCanvasElement {
        const c = document.createElement('canvas');
        renderToCanvas(c, current!, state, qrAssets(), width);
        return c;
    }

    function buildSvg(): string {
        return renderToSvg(current!, state, qrAssets());
    }

    const DOWNLOAD_GOALS: Record<DownloadFormat, string> = {
        png: METRIKA_GOALS.qrDownloadPng,
        jpg: METRIKA_GOALS.qrDownloadJpg,
        svg: METRIKA_GOALS.qrDownloadSvg,
    };
    let downloaded = false;

    async function download(format: DownloadFormat) {
        if (!current) return;
        const base = `qrstars-qr-${state.type}`;
        let blob: Blob;
        let filename: string;
        if (format === 'svg') {
            blob = new Blob([buildSvg()], { type: 'image/svg+xml' });
            filename = `${base}.svg`;
        } else {
            let c = renderScaled(state.exportSize);
            if (format === 'jpg') {
                // В JPG нет прозрачности — подкладываем белый.
                const flat = document.createElement('canvas');
                flat.width = c.width;
                flat.height = c.height;
                const fctx = flat.getContext('2d')!;
                fctx.fillStyle = '#ffffff';
                fctx.fillRect(0, 0, flat.width, flat.height);
                fctx.drawImage(c, 0, 0);
                c = flat;
            }
            blob = await canvasToBlob(c, format === 'png' ? 'image/png' : 'image/jpeg', 0.92);
            filename = `${base}-${state.exportSize}px.${format}`;
        }
        const via = await deliverFile(blob, filename, format !== 'svg');
        if (via === 'cancelled') return;
        downloaded = true;
        goal(DOWNLOAD_GOALS[format], { qr_type: state.type, size: format === 'svg' ? 'vector' : state.exportSize, via });
        showAfterDownload();
    }

    downloadBtns.forEach(btn => btn.addEventListener('click', () => {
        download(btn.dataset.download as DownloadFormat).catch(() => {});
    }));

    // ── После скачивания: предложение динамического кода ─
    const AFTER_DOWNLOAD_KEY = 'qrstars:gen-after-download';
    function showAfterDownload() {
        try {
            if (sessionStorage.getItem(AFTER_DOWNLOAD_KEY)) return;
            sessionStorage.setItem(AFTER_DOWNLOAD_KEY, '1');
        } catch { /* приватный режим — покажем как есть */ }
        const cta = $('qr-after-cta') as HTMLAnchorElement;
        const isMaps = state.type === 'maps';
        $('qr-after-text').textContent = isMaps
            ? 'Этот код пустит на карты и недовольных гостей. QR для отзывов QrStars сначала спросит оценку — жалобы придут вам, а не на Яндекс.'
            : 'Это статический код: он не покажет, сколько раз его отсканировали, а ссылку нельзя поменять после печати.';
        $('qr-after-cta-text').textContent = isMaps ? 'Собирать отзывы с фильтром — бесплатно' : 'Сделать такой же динамический — бесплатно';
        if (isMaps && cta.dataset.reviewsHref) cta.href = cta.dataset.reviewsHref;
        cta.dataset.goalParams = JSON.stringify({ source: isMaps ? 'post_download_maps' : 'post_download' });
        show($('qr-after-download'), true);
    }
    $('qr-after-close').addEventListener('click', () => show($('qr-after-download'), false));

    // ── Полноэкранный просмотр и макеты ──────────────────
    function updateMockTitles() {
        document.querySelectorAll<HTMLElement>('[data-mock-title]').forEach(el => (el.textContent = MOCK_TITLES[state.type]));
    }

    function refreshDialogImages() {
        if (!current) return;
        const url = renderScaled(1200).toDataURL('image/png');
        document.querySelectorAll<HTMLImageElement>('.mock-qr').forEach(img => (img.src = url));
    }

    function openDialog() {
        // Сразу после смены вкладки перерисовка ещё ждёт таймера — не теряем тап.
        if (updateTimer) generateNow();
        if (!current) {
            (document.querySelector<HTMLElement>(`#form-${state.type} input, #form-${state.type} textarea`))?.focus();
            return;
        }
        refreshDialogImages();
        renderScanAlerts(lastScanLevel);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        goal(METRIKA_GOALS.qrFullscreen, { qr_type: state.type });
    }
    previewWrapper.addEventListener('click', openDialog);
    $('btn-fullscreen').addEventListener('click', openDialog);
    btnMoreMobile.addEventListener('click', openDialog);
    $('qr-dialog-close').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; });

    document.querySelectorAll<HTMLButtonElement>('.mock-tab').forEach(tab => tab.addEventListener('click', () => {
        const mock = tab.dataset.mock!;
        $('mock-stage').dataset.mock = mock;
        document.querySelectorAll('.mock-tab').forEach(t => t.classList.toggle('active-tab', t === tab));
        goal(METRIKA_GOALS.qrMockup, { mockup: mock, qr_type: state.type });
    }));

    // ── Случайное оформление (только читаемые сочетания) ─
    const randomFrom = <T,>(arr: readonly T[]): T => arr[Math.floor(Math.random() * arr.length)];
    const FRAME_TEXTS = ['СКАНИРУЙ МЕНЯ', 'НАВЕДИ КАМЕРУ', 'ОТКРОЙ', 'ПОДРОБНЕЕ', 'МЕНЮ', 'ОТЗЫВ', 'WI‑FI'];

    async function applyRandomDesign() {
        const palette = randomReadablePalette();
        state.fg = palette.fg;
        state.bg = palette.bg;
        state.bgTransparent = false;
        state.gradient = palette.gradient;
        state.grad1 = palette.grad1;
        state.grad2 = palette.grad2;
        state.gradType = randomFrom(GRAD_TYPES);
        state.eyeCustom = Math.random() < 0.35;
        state.eyeColor = palette.eyeColor;
        state.dotStyle = randomFrom(DOT_STYLES);
        state.eyeStyle = randomFrom(EYE_STYLES);

        state.centerMode = 'image';
        // Свой загруженный логотип не трогаем — человек его уже выбрал.
        if (state.logoKey !== 'upload') {
            if (Math.random() < 0.45) {
                const idx = Math.floor(Math.random() * LOGO_PRESETS.length);
                state.logoImage = await loadLogoPreset(idx);
                state.logoKey = idx;
            } else {
                state.logoImage = null;
                state.logoKey = null;
            }
        }
        state.logoSize = 16 + Math.floor(Math.random() * 8);
        state.logoFill = false;

        state.frame = Math.random() < 0.35;
        if (state.frame) {
            state.frameText = randomFrom(FRAME_TEXTS);
            state.frameStyle = randomFrom(FRAME_STYLES);
        }
        state.scatter = Math.random() < 0.2;
        if (state.scatter) {
            state.scatterDensity = 1 + Math.floor(Math.random() * 4);
            state.scatterShape = randomFrom(SCATTER_SHAPES);
        }
        state.ecc = state.logoImage ? 'H' : randomFrom<Ecc>(['Q', 'H']);
        state.margin = 1 + Math.floor(Math.random() * 3);
        state.photoImage = null;
        state.photoKey = null;
        state.photoStyle = 'overlay';
        state.silhouette = 'none';
        state.inkShift = false;
        state.rotate45 = !state.frame && Math.random() < 0.1;
        clearColorPresetMark();
        syncUiFromState();
    }

    let randomizing = false;
    async function randomizeQr() {
        if (randomizing) return;
        randomizing = true;
        try {
            // Перебираем, пока jsQR не прочитает код уверенно (обычно с первого раза).
            for (let attempt = 0; attempt < 4; attempt++) {
                await applyRandomDesign();
                generateNow();
                if (!current || checkScanLevel() === 'ok') break;
            }
            designTouched = true;
            saveToHash();
            goal(METRIKA_GOALS.qrRandom, { qr_type: state.type });
        } finally {
            randomizing = false;
        }
    }
    $('btn-random').addEventListener('click', randomizeQr);
    $('btn-random-mobile').addEventListener('click', randomizeQr);

    // ── Ссылка с настройками (#hash) ─────────────────────
    const HEX6 = /^[0-9a-fA-F]{6}$/;
    const FORM_HASH_FIELDS: Partial<Record<QrType, [string, string][]>> = {
        url: [['d', 'input-url']],
        text: [['d', 'input-text']],
        phone: [['d', 'input-phone']],
        email: [['ea', 'input-email-addr'], ['esub', 'input-email-subj'], ['ebody', 'input-email-body']],
        vcard: [['vfn', 'input-vcard-fname'], ['vln', 'input-vcard-lname'], ['vph', 'input-vcard-phone'], ['vem', 'input-vcard-email'], ['vorg', 'input-vcard-org'], ['vurl', 'input-vcard-url']],
        sms: [['sph', 'input-sms-phone'], ['sbody', 'input-sms-body']],
        telegram: [['d', 'input-tg']],
        whatsapp: [['wph', 'input-wa-phone'], ['wtx', 'input-wa-text']],
        pay: [['pn', 'input-pay-name'], ['pa', 'input-pay-acc'], ['pbic', 'input-pay-bic'], ['pb', 'input-pay-bank'], ['pc', 'input-pay-corr'], ['pinn', 'input-pay-inn'], ['ps', 'input-pay-sum'], ['pp', 'input-pay-purpose']],
        maps: [['d', 'input-maps']],
    };

    function saveToHash() {
        const p = new URLSearchParams();
        p.set('t', state.type);
        p.set('ds', state.dotStyle);
        p.set('ey', state.eyeStyle);
        p.set('fg', state.fg.replace('#', ''));
        p.set('bg', state.bg.replace('#', ''));
        if (state.bgTransparent) p.set('bgt', '1');
        if (state.gradient) {
            p.set('g', '1');
            p.set('g1', state.grad1.replace('#', ''));
            p.set('g2', state.grad2.replace('#', ''));
            p.set('gt', state.gradType);
        }
        if (state.eyeCustom) {
            p.set('ec', '1');
            p.set('ecl', state.eyeColor.replace('#', ''));
        }
        if (typeof state.logoKey === 'number') p.set('lp', String(state.logoKey));
        if (state.centerMode === 'text') {
            p.set('cm', 'text');
            p.set('ct', state.centerText);
            p.set('ctf', state.centerTextFont);
            p.set('ctc', state.centerTextColor.replace('#', ''));
            if (!state.centerTextBold) p.set('ctb', '0');
        }
        p.set('ls', String(state.logoSize));
        if (state.logoFill) p.set('lf', '1');
        if (state.frame) {
            p.set('fr', '1');
            p.set('ft', state.frameText);
            p.set('fst', state.frameStyle);
        }
        if (state.scatter) {
            p.set('sc', '1');
            p.set('sd', String(state.scatterDensity));
            p.set('ssh', state.scatterShape);
        }
        if (state.photoStyle === 'halftone') p.set('pst', 'h');
        // Своя фигура — картинка, в ссылку не влезает.
        if (state.silhouette !== 'none' && state.silhouette !== 'custom') {
            p.set('sil', state.silhouette);
            p.set('sf', String(state.silhouetteFit));
        }
        if (state.rotate45) p.set('r45', '1');
        if (state.inkShift) p.set('ink', '1');
        p.set('ecc', state.ecc);
        p.set('m', String(state.margin));
        if (state.exportSize !== 1200) p.set('sz', String(state.exportSize));
        if (designTouched) p.set('dt', '1');

        if (state.type === 'wifi') {
            p.set('ssid', input('input-wifi-ssid').value);
            p.set('wp', input('input-wifi-pass').value);
            p.set('enc', ($('input-wifi-enc') as HTMLSelectElement).value);
        }
        for (const [key, id] of FORM_HASH_FIELDS[state.type] ?? []) p.set(key, fieldValue(id));

        const hash = '#' + p.toString();
        if (location.hash !== hash) history.replaceState(null, '', hash);
    }

    function intParam(params: URLSearchParams, key: string, min: number, max: number): number | null {
        const raw = params.get(key);
        if (raw === null || !/^\d+$/.test(raw)) return null;
        const v = parseInt(raw, 10);
        return v >= min && v <= max ? v : null;
    }

    /** Восстанавливает состояние из #hash. Возвращает индекс пресета логотипа, если он был. */
    function loadFromHash(): number | null {
        const raw = location.hash.slice(1);
        if (!raw) return null;
        let params: URLSearchParams;
        try { params = new URLSearchParams(raw); } catch { return null; }

        const type = params.get('t') as QrType | null;
        if (type && QR_TYPES.includes(type)) state.type = type;
        const ds = params.get('ds') as DotStyle | null;
        if (ds && DOT_STYLES.includes(ds)) state.dotStyle = ds;
        const ey = params.get('ey') as EyeStyle | null;
        if (ey && EYE_STYLES.includes(ey)) state.eyeStyle = ey;
        const fg = params.get('fg');
        if (fg && HEX6.test(fg)) state.fg = `#${fg.toLowerCase()}`;
        const bg = params.get('bg');
        if (bg && HEX6.test(bg)) state.bg = `#${bg.toLowerCase()}`;
        state.bgTransparent = params.get('bgt') === '1';

        state.gradient = params.get('g') === '1';
        const g1 = params.get('g1');
        if (g1 && HEX6.test(g1)) state.grad1 = `#${g1.toLowerCase()}`;
        const g2 = params.get('g2');
        if (g2 && HEX6.test(g2)) state.grad2 = `#${g2.toLowerCase()}`;
        const gt = params.get('gt') as GradType | null;
        if (gt && GRAD_TYPES.includes(gt)) state.gradType = gt;

        state.eyeCustom = params.get('ec') === '1';
        const ecl = params.get('ecl');
        if (ecl && HEX6.test(ecl)) state.eyeColor = `#${ecl.toLowerCase()}`;

        state.logoSize = intParam(params, 'ls', 10, 30) ?? state.logoSize;
        if (params.get('cm') === 'text') {
            state.centerMode = 'text';
            state.centerText = (params.get('ct') ?? '').split('\n').slice(0, 3).map(l => l.slice(0, 24)).join('\n');
            const ctf = params.get('ctf') as QrCenterTextFont | null;
            if (ctf && CENTER_TEXT_FONTS.some(f => f.id === ctf)) state.centerTextFont = ctf;
            const ctc = params.get('ctc');
            if (ctc && HEX6.test(ctc)) state.centerTextColor = `#${ctc.toLowerCase()}`;
            state.centerTextBold = params.get('ctb') !== '0';
        }
        state.logoFill = params.get('lf') === '1';

        state.frame = params.get('fr') === '1';
        const ft = params.get('ft');
        if (ft) state.frameText = ft.slice(0, 32);
        const fst = params.get('fst') as FrameStyle | null;
        if (fst && FRAME_STYLES.includes(fst)) state.frameStyle = fst;

        state.scatter = params.get('sc') === '1';
        state.scatterDensity = intParam(params, 'sd', 1, 10) ?? state.scatterDensity;
        const ssh = params.get('ssh') as ScatterShape | null;
        if (ssh && SCATTER_SHAPES.includes(ssh)) state.scatterShape = ssh;

        state.photoStyle = params.get('pst') === 'h' ? 'halftone' : 'overlay';
        const sil = params.get('sil') as QrSilhouette | null;
        state.silhouette = sil && sil !== 'custom' && SILHOUETTES.includes(sil) ? sil : 'none';
        state.silhouetteFit = intParam(params, 'sf', 50, 100) ?? state.silhouetteFit;
        state.rotate45 = params.get('r45') === '1';
        state.inkShift = params.get('ink') === '1';

        const ecc = params.get('ecc') as Ecc | null;
        if (ecc && ECC_LEVELS.includes(ecc)) state.ecc = ecc;
        state.margin = intParam(params, 'm', 0, 6) ?? state.margin;
        const sz = intParam(params, 'sz', 600, 2000);
        if (sz && EXPORT_SIZES.includes(sz)) state.exportSize = sz;
        designTouched = params.get('dt') === '1';

        if (state.type === 'wifi') {
            { const v = params.get('ssid'); if (v !== null) input('input-wifi-ssid').value = v; }
            { const v = params.get('wp'); if (v !== null) input('input-wifi-pass').value = v; }
            { const v = params.get('enc'); if (v) ($('input-wifi-enc') as HTMLSelectElement).value = v; }
        }
        for (const [key, id] of FORM_HASH_FIELDS[state.type] ?? []) {
            const v = params.get(key);
            if (v !== null) ($(id) as HTMLInputElement).value = v;
        }
        return intParam(params, 'lp', 0, LOGO_PRESETS.length - 1);
    }

    // ── Перенос дизайна в кабинет при регистрации ────────
    function currentTransferStyle(): TransferStyle {
        const preset = typeof state.logoKey === 'number' ? LOGO_PRESETS[state.logoKey] : null;
        return {
            v: 1,
            dotStyle: state.dotStyle,
            eyeStyle: state.eyeStyle,
            fg: state.fg,
            bg: state.bg,
            bgTransparent: state.bgTransparent,
            gradient: state.gradient,
            grad1: state.grad1,
            grad2: state.grad2,
            gradType: state.gradType,
            eyeCustom: state.eyeCustom,
            eyeColor: state.eyeColor,
            logoPreset: preset?.emoji ?? null,
            logoSrc: preset?.src === '/logo.svg' ? '/logo.svg' : null,
            logoFill: state.logoFill,
            logoSize: state.logoSize,
            frame: state.frame,
            frameText: state.frameText.slice(0, 32),
            frameStyle: state.frameStyle,
            ecc: state.ecc,
            margin: state.margin,
            scatter: state.scatter,
            scatterDensity: state.scatterDensity,
            scatterShape: state.scatterShape,
            centerMode: state.centerMode,
            centerText: state.centerMode === 'text' ? state.centerText : '',
            centerTextFont: state.centerTextFont,
            centerTextColor: state.centerTextColor,
            centerTextBold: state.centerTextBold,
            ...(state.silhouette !== 'none' && state.silhouette !== 'custom'
                ? { silhouette: state.silhouette, silhouetteFit: state.silhouetteFit }
                : {}),
            ...(state.rotate45 ? { rotate45: true } : {}),
            ...(state.inkShift ? { inkShift: true } : {}),
        };
    }

    function attachStyleToRegisterLink(e: MouseEvent) {
        const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
        if (!a || !isAppRegisterLink(a.href)) return;
        if (!designTouched && !downloaded) return;
        a.href = withTransferStyle(a.href, encodeTransferStyle(currentTransferStyle()));
        goal(METRIKA_GOALS.qrStyleTransfer, { qr_type: state.type });
    }
    document.addEventListener('click', attachStyleToRegisterLink, true);
    document.addEventListener('auxclick', attachStyleToRegisterLink, true);

    // ── Init ──────────────────────────────────────────────
    /** Сразу открыты только «Арт-стили» и «Цвет»: остальное — тонкая настройка, в заголовке видно текущее значение. */
    function initAccordions() {
        document.querySelectorAll<HTMLDetailsElement>('.qr-acc').forEach(d => {
            d.open = d.dataset.acc === 'color' || d.dataset.acc === 'art';
        });
    }

    renderColorPresets();
    renderArtCategories();
    renderArtPresets();
    syncArtCategories();
    renderLogoPresets();
    renderPhotoPresets();
    const hashLogo = loadFromHash();
    syncUiFromState();
    initAccordions();
    if (!location.hash) document.querySelector('.preset-btn')?.classList.add('is-active');

    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        '.qr-form input, .qr-form textarea, .qr-form select'
    ).forEach(el => {
        el.addEventListener('input', () => {
            userEditedData = true;
            scheduleUpdate();
        });
        el.addEventListener('keydown', e => {
            // Enter на телефоне прячет клавиатуру — чтобы сразу был виден код в нижней панели.
            if ((e as KeyboardEvent).key === 'Enter' && el.tagName !== 'TEXTAREA') {
                e.preventDefault();
                if (isTouchDevice()) (el as HTMLElement).blur();
                generateNow();
            }
        });
    });

    if (hashLogo !== null) {
        selectLogoPreset(hashLogo).then(generateNow);
    }
    generateNow();

    // `?art=` — переход из галереи на главной: сразу применяем стиль. Своя ссылка с #hash важнее.
    const artParam = new URLSearchParams(location.search).get('art');
    const artIdx = artParam && !location.hash ? ART_PRESETS.findIndex(p => p.id === artParam) : -1;
    if (artIdx >= 0) {
        artExpanded = true;
        document.querySelectorAll('.art-preset-btn').forEach(b => b.classList.toggle('is-active', b.getAttribute('data-art') === String(artIdx)));
        syncArtCategories();
        designTouched = true;
        applyArtPreset(artIdx).then(generateNow);
    }
</script>
