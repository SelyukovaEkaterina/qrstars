    // ── Logo images ───────────────────────────────────────
    function emojiToImage(emoji: string): HTMLImageElement {
        const size = 200;
        const c = document.createElement('canvas');
        c.width = size;
        c.height = size;
        const ectx = c.getContext('2d')!;
        ectx.font = `${size * 0.7}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
        ectx.textAlign = 'center';
        ectx.textBaseline = 'middle';
        ectx.fillText(emoji, size / 2, size / 2);
        const img = new Image();
        img.src = c.toDataURL();
        return img;
    }

    const logoCache = new Map<number, Promise<HTMLImageElement>>();
    /** Картинка пресета, уже готовая к drawImage (иначе первый кадр рисуется без логотипа). */
    function loadLogoPreset(idx: number): Promise<HTMLImageElement> {
        let p = logoCache.get(idx);
        if (!p) {
            const preset = LOGO_PRESETS[idx];
            const img = preset.emoji ? emojiToImage(preset.emoji) : new Image();
            if (preset.src) img.src = preset.src;
            p = img.decode().then(() => img).catch(() => img);
            logoCache.set(idx, p);
        }
        return p;
    }

    async function selectLogoPreset(idx: number | null) {
        if (idx === null) {
            state.logoImage = null;
            state.logoKey = null;
        } else {
            state.logoImage = await loadLogoPreset(idx);
            state.logoKey = idx;
        }
        input('input-logo').value = '';
        $('logo-label').textContent = 'Загрузить свой';
        syncLogoUi();
        scheduleUpdate();
    }

