        bgTransparent: false, eyeCustom: false, frame: false, scatter: false, silhouette: 'none', silhouetteFit: 100,
        rotate45: false, inkShift: false, photoStyle: 'overlay', logoFill: false, logoSize: 20, centerMode: 'image',
        grad1: '#4f46e5', grad2: '#a855f7',
    };

    /** Подпись на макете таблички — под тип кода. */
