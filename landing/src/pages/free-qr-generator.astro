        { name: 'Корона', emoji: '👑' },
        { name: 'Ракета', emoji: '🚀' },
        { name: 'Молния', emoji: '⚡' },
        { name: 'Глаз', emoji: '👁️' },
        { name: 'Такси', emoji: '🚕' },
        { name: 'Самолёт', emoji: '✈️' },
        { name: 'Дом', emoji: '🏠' },
        { name: 'Ключ', emoji: '🔑' },
        { name: 'Подарок', emoji: '🎁' },
        { name: 'Сердце', emoji: '❤️' },
        { name: 'Звезда', emoji: '⭐' },
        { name: 'Огонь', emoji: '🔥' },
        { name: 'Кошка', emoji: '🐱' },
        { name: 'Круг', emoji: '🎯' },
        // Новые — только в конец: в ссылке (#lp=) хранится номер логотипа.
        { name: 'Мастер', emoji: '🔨' },
