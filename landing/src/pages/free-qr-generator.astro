---
import Layout from '../layouts/Layout.astro';
import UxCheckPromo from '../components/UxCheckPromo.astro';
import { generatorRegisterUrl, reviewsRegisterUrl } from '../lib/utm';

const APP_URL_REGISTER = generatorRegisterUrl('free-qr-generator', Astro.url.searchParams);
const REVIEWS_PIVOT_URL = reviewsRegisterUrl('free-qr-generator-pivot', Astro.url.searchParams);
const REVIEWS_MAPS_URL = reviewsRegisterUrl('free-qr-generator-maps', Astro.url.searchParams);

const faqItems = [
  {
    q: 'Бесплатный генератор QR-кода — нужна ли регистрация?',
    a: 'Нет. Статический QR (ссылка, Wi‑Fi, Telegram, WhatsApp, оплата по реквизитам, визитка) создаётся и скачивается в PNG до 2000 px, вектором SVG или в JPG прямо на этой странице — без аккаунта и без карты. Регистрация нужна только для динамического кода со статистикой и сменой ссылки.',
  },
  {
    q: 'Мой QR-код может устареть или отключиться со временем?',
    a: 'Нет, если вы создали статический код на этой странице. Данные кодируются непосредственно в сам рисунок точек. Такой код полностью автономен, работает без участия наших серверов и будет открываться вечно.',
  },
  {
    q: 'Можно ли отредактировать ссылку в скачанном QR-коде?',
    a: 'В статическом коде (скачанном без регистрации) это невозможно, так как адрес зашит в саму структуру картинки. Если вам нужно иметь возможность менять ссылку после печати листовок, бесплатно зарегистрируйтесь и выберите создание «Динамического QR-кода» — дизайн из генератора перенесётся в кабинет.',
  },
  {
    q: 'В каком формате скачать QR-код для типографии?',
    a: 'Выбирайте SVG — это вектор, он масштабируется до любого размера без потери резкости. Для документов, соцсетей и офисной печати подойдёт PNG 1200 или 2000 px. В фото-режиме SVG содержит фотографию как вложенную картинку.',
  },
  {
    q: 'Какой размер логотипа лучше загружать в центр кода?',
    a: 'Подойдет любое квадратное изображение. Рекомендуем использовать простые контрастные логотипы без мелких деталей. Наша система автоматически настраивает уровень коррекции ошибок (до 30%), чтобы встроенная картинка не мешала сканированию.',
  },
  {
    q: 'Почему мой цветной или градиентный QR-код не сканируется?',
    a: 'Самая частая причина — недостаточный контраст. Камеры телефонов отлично считывают темные точки на светлом фоне. Если вы сделали точки светлыми или использовали темный фон с темными точками, сканер не сможет распознать код. Генератор сам проверяет код и предупреждает, если он может плохо читаться.',
  },
  {
    q: 'Как сделать QR-код для оплаты по реквизитам?',
    a: 'Откройте вкладку «Оплата», укажите получателя, расчётный счёт, БИК, банк и корреспондентский счёт. Код делается по ГОСТ Р 56042-2014: приложения Сбербанка, Т‑Банка, ВТБ, Альфа-Банка и других откроют перевод с заполненными реквизитами. QR для оплаты через СБП выдаёт только банк.',
  },
  {
    q: 'Есть ли ограничения по количеству сканирований?',
    a: 'Нет. Созданные в онлайн-генераторе QrStars статические и динамические QR-коды не имеют ограничений на количество сканирований и переходов пользователей.',
  },
];

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const QR_TABS = [
  { type: 'url', icon: 'fa-solid fa-link', label: 'Ссылка' },
  { type: 'wifi', icon: 'fa-solid fa-wifi', label: 'Wi‑Fi' },
  { type: 'telegram', icon: 'fa-brands fa-telegram', label: 'Telegram' },
  { type: 'whatsapp', icon: 'fa-brands fa-whatsapp', label: 'WhatsApp' },
  { type: 'pay', icon: 'fa-solid fa-ruble-sign', label: 'Оплата' },
  { type: 'maps', icon: 'fa-solid fa-star', label: 'Карты' },
  { type: 'text', icon: 'fa-solid fa-font', label: 'Текст' },
  { type: 'phone', icon: 'fa-solid fa-phone', label: 'Телефон' },
  { type: 'email', icon: 'fa-solid fa-envelope', label: 'Email' },
  { type: 'vcard', icon: 'fa-solid fa-id-card', label: 'Контакт' },
  { type: 'sms', icon: 'fa-solid fa-comment-sms', label: 'SMS' },
];
---

<Layout
  title="Бесплатный генератор QR-кода онлайн — без регистрации | QrStars"
  description="Бесплатный генератор QR-кода онлайн: создайте куар код за 30 секунд без регистрации. Ссылка, Wi‑Fi, Telegram, WhatsApp, оплата по реквизитам. Цвета, логотип, рамка — скачайте PNG до 2000 px или SVG. Альтернатива WBShark."
  fullTitle={true}
  canonical="https://qrstars.ru/free-qr-generator.html"
>

    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

    <section class="pt-20 pb-3 lg:pt-[5.5rem] lg:pb-5 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <div class="inline-block bg-primary/10 text-primary font-semibold px-4 py-1.5 rounded-full text-xs sm:text-sm mb-3 lg:mb-4 border border-primary/20">
                Бесплатно &middot; Без регистрации &middot; PNG / SVG
            </div>
            <h1 class="text-[1.65rem] leading-[1.15] md:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight lg:leading-tight mb-2 lg:mb-3 max-w-4xl mx-auto">
                Бесплатный генератор <span class="bg-gradient-to-r from-primary to-purple-500 gradient-text">QR-кода</span> онлайн
            </h1>
            <p class="text-base lg:text-lg text-slate-600 mb-0 max-w-2xl mx-auto">
                <span class="lg:hidden">Логотип, цвет и скачивание — без регистрации.</span>
                <span class="hidden lg:inline">Логотип, цвета и рамка — скачайте PNG до 2000 px или вектор SVG. Без водяных знаков, код работает вечно.</span>
            </p>
        </div>
    </section>

    <section class="pb-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-slate-50 rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-4 sm:p-6 md:p-8">
                    <div class="qr-tabs-row -mx-4 px-4 sm:mx-0 sm:px-0 flex gap-2 lg:gap-1.5 mb-4 lg:mb-5 overflow-x-auto lg:flex-wrap lg:overflow-visible" id="qr-tabs" role="tablist">
                        {QR_TABS.map((tab, i) => (
                            <button type="button" role="tab" data-type={tab.type} class={`qr-tab shrink-0 whitespace-nowrap px-4 lg:px-2.5 py-2.5 lg:py-2 rounded-xl text-sm lg:text-[0.8125rem] font-semibold transition${i === 0 ? ' active-tab' : ''}`}>
                                <i class={`${tab.icon} mr-1.5 lg:mr-1`}></i>{tab.label}
                            </button>
                        ))}
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-6 lg:gap-8">
                        <div class="max-lg:order-1 lg:col-start-1 lg:row-start-1 min-w-0">
                            <div id="form-url" class="qr-form">
                                <label for="input-url" class="block text-sm font-semibold text-slate-700 mb-2">Адрес ссылки</label>
                                <input type="url" inputmode="url" autocomplete="url" id="input-url" placeholder="https://example.com" value="https://qrstars.ru" class="qr-input" />
                                <p class="mt-2 text-xs text-slate-500 leading-relaxed">
                                    <i class="fa-solid fa-circle-info text-primary/70 mr-1"></i>
                                    Этот код «зашьёт» ссылку навсегда — поменять её после печати нельзя.
                                    <a href={APP_URL_REGISTER} data-goal="qr_dynamic_cta" data-goal-params='{"source":"url_hint"}' class="text-primary font-semibold hover:underline">Сделайте динамический QR бесплатно</a> — ссылку можно менять, видна статистика сканирований.
                                </p>
                            </div>

                            <div id="form-wifi" class="qr-form hidden">
                                <div class="space-y-4">
                                    <div>
                                        <label for="input-wifi-ssid" class="block text-sm font-semibold text-slate-700 mb-2">Название сети (SSID)</label>
                                        <input type="text" id="input-wifi-ssid" placeholder="MyNetwork" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-wifi-pass" class="block text-sm font-semibold text-slate-700 mb-2">Пароль</label>
                                        <input type="text" id="input-wifi-pass" placeholder="••••••••" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-wifi-enc" class="block text-sm font-semibold text-slate-700 mb-2">Тип шифрования</label>
                                        <select id="input-wifi-enc" class="qr-input bg-white">
                                            <option value="WPA">WPA/WPA2</option>
                                            <option value="WEP">WEP</option>
                                            <option value="nopass">Без пароля</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div id="form-telegram" class="qr-form hidden">
                                <label for="input-tg" class="block text-sm font-semibold text-slate-700 mb-2">Username или ссылка</label>
                                <input type="text" id="input-tg" autocapitalize="off" autocomplete="off" spellcheck="false" placeholder="@qrstars или t.me/qrstars" class="qr-input" />
                                <p class="mt-2 text-xs text-slate-500">Подойдёт профиль, канал, группа или бот. Код откроет Telegram сразу на нужном чате.</p>
                            </div>

                            <div id="form-whatsapp" class="qr-form hidden">
                                <div class="space-y-4">
                                    <div>
                                        <label for="input-wa-phone" class="block text-sm font-semibold text-slate-700 mb-2">Номер WhatsApp</label>
                                        <input type="tel" inputmode="tel" id="input-wa-phone" placeholder="+7 999 123-45-67" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-wa-text" class="block text-sm font-semibold text-slate-700 mb-2">Готовое сообщение (необязательно)</label>
                                        <textarea id="input-wa-text" rows="2" placeholder="Здравствуйте! Хочу записаться" class="qr-input resize-none"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div id="form-pay" class="qr-form hidden">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="sm:col-span-2">
                                        <label for="input-pay-name" class="block text-sm font-semibold text-slate-700 mb-2">Получатель</label>
                                        <input type="text" id="input-pay-name" placeholder="ИП Иванов Иван Иванович" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-pay-acc" class="block text-sm font-semibold text-slate-700 mb-2">Расчётный счёт</label>
                                        <input type="text" inputmode="numeric" maxlength="24" id="input-pay-acc" placeholder="40802810000000000000" class="qr-input font-mono" />
                                    </div>
                                    <div>
                                        <label for="input-pay-bic" class="block text-sm font-semibold text-slate-700 mb-2">БИК банка</label>
                                        <input type="text" inputmode="numeric" maxlength="11" id="input-pay-bic" placeholder="044525225" class="qr-input font-mono" />
                                    </div>
                                    <div>
                                        <label for="input-pay-bank" class="block text-sm font-semibold text-slate-700 mb-2">Банк</label>
                                        <input type="text" id="input-pay-bank" placeholder="ПАО Сбербанк" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-pay-corr" class="block text-sm font-semibold text-slate-700 mb-2">Корр. счёт</label>
                                        <input type="text" inputmode="numeric" maxlength="24" id="input-pay-corr" placeholder="30101810400000000225" class="qr-input font-mono" />
                                    </div>
                                    <div>
                                        <label for="input-pay-inn" class="block text-sm font-semibold text-slate-700 mb-2">ИНН (необязательно)</label>
                                        <input type="text" inputmode="numeric" maxlength="12" id="input-pay-inn" placeholder="7700000000" class="qr-input font-mono" />
                                    </div>
                                    <div>
                                        <label for="input-pay-sum" class="block text-sm font-semibold text-slate-700 mb-2">Сумма, ₽ (необязательно)</label>
                                        <input type="text" inputmode="decimal" id="input-pay-sum" placeholder="1500" class="qr-input" />
                                    </div>
                                    <div class="sm:col-span-2">
                                        <label for="input-pay-purpose" class="block text-sm font-semibold text-slate-700 mb-2">Назначение платежа (необязательно)</label>
                                        <input type="text" id="input-pay-purpose" placeholder="Оплата по счёту №15" class="qr-input" />
                                    </div>
                                </div>
                                <p class="mt-3 text-xs text-slate-500 leading-relaxed">
                                    <i class="fa-solid fa-circle-info text-primary/70 mr-1"></i>
                                    Формат ГОСТ Р 56042: Сбербанк, Т‑Банк, ВТБ, Альфа-Банк и другие приложения откроют перевод с заполненными реквизитами. Это не QR СБП — его выдаёт банк при подключении эквайринга.
                                </p>
                            </div>

                            <div id="form-maps" class="qr-form hidden">
                                <label for="input-maps" class="block text-sm font-semibold text-slate-700 mb-2">Ссылка на карточку в Яндекс Картах или 2ГИС</label>
                                <input type="url" inputmode="url" id="input-maps" placeholder="https://yandex.ru/maps/org/…" class="qr-input" />
                                <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50 p-4">
                                    <p class="text-sm font-semibold text-slate-900 mb-1 flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved text-amber-500"></i>
                                        Статический код пустит на карты и недовольных гостей
                                    </p>
                                    <p class="text-sm text-slate-700 leading-relaxed mb-3">
                                        Этот QR просто откроет карточку — гость напишет что угодно. QR для отзывов QrStars сначала спросит оценку: 4–5★ уйдут на Яндекс Карты, а жалобы на 1–3★ придут вам на почту и не попадут в интернет.
                                    </p>
                                    <a href={REVIEWS_MAPS_URL} data-goal="qr_dynamic_cta" data-goal-params='{"source":"maps_pivot"}' class="inline-flex items-center gap-2 bg-primary text-white px-4 py-2.5 rounded-xl font-bold text-sm hover:bg-indigo-700 transition">
                                        Создать QR для отзывов бесплатно
                                        <i class="fa-solid fa-arrow-right text-xs"></i>
                                    </a>
                                </div>
                            </div>

                            <div id="form-text" class="qr-form hidden">
                                <label for="input-text" class="block text-sm font-semibold text-slate-700 mb-2">Произвольный текст</label>
                                <textarea id="input-text" rows="5" placeholder="Введите текст..." class="qr-input resize-none"></textarea>
                            </div>

                            <div id="form-email" class="qr-form hidden">
                                <div class="space-y-4">
                                    <div>
                                        <label for="input-email-addr" class="block text-sm font-semibold text-slate-700 mb-2">Email-адрес</label>
                                        <input type="email" inputmode="email" id="input-email-addr" placeholder="hello@example.com" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-email-subj" class="block text-sm font-semibold text-slate-700 mb-2">Тема (необязательно)</label>
                                        <input type="text" id="input-email-subj" placeholder="Тема письма" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-email-body" class="block text-sm font-semibold text-slate-700 mb-2">Сообщение (необязательно)</label>
                                        <textarea id="input-email-body" rows="3" placeholder="Текст письма..." class="qr-input resize-none"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div id="form-phone" class="qr-form hidden">
                                <label for="input-phone" class="block text-sm font-semibold text-slate-700 mb-2">Номер телефона</label>
                                <input type="tel" inputmode="tel" id="input-phone" placeholder="+7 (999) 123-45-67" class="qr-input" />
                            </div>

                            <div id="form-vcard" class="qr-form hidden">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label for="input-vcard-fname" class="block text-sm font-semibold text-slate-700 mb-2">Имя</label>
                                        <input type="text" id="input-vcard-fname" placeholder="Иван" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-vcard-lname" class="block text-sm font-semibold text-slate-700 mb-2">Фамилия</label>
                                        <input type="text" id="input-vcard-lname" placeholder="Иванов" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-vcard-phone" class="block text-sm font-semibold text-slate-700 mb-2">Телефон</label>
                                        <input type="tel" inputmode="tel" id="input-vcard-phone" placeholder="+7 999 123-45-67" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-vcard-email" class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
                                        <input type="email" inputmode="email" id="input-vcard-email" placeholder="ivan@mail.ru" class="qr-input" />
                                    </div>
                                    <div class="sm:col-span-2">
                                        <label for="input-vcard-org" class="block text-sm font-semibold text-slate-700 mb-2">Организация</label>
                                        <input type="text" id="input-vcard-org" placeholder="ООО Ромашка" class="qr-input" />
                                    </div>
                                    <div class="sm:col-span-2">
                                        <label for="input-vcard-url" class="block text-sm font-semibold text-slate-700 mb-2">Сайт</label>
                                        <input type="url" inputmode="url" id="input-vcard-url" placeholder="https://example.com" class="qr-input" />
                                    </div>
                                </div>
                            </div>

                            <div id="form-sms" class="qr-form hidden">
                                <div class="space-y-4">
                                    <div>
                                        <label for="input-sms-phone" class="block text-sm font-semibold text-slate-700 mb-2">Номер получателя</label>
                                        <input type="tel" inputmode="tel" id="input-sms-phone" placeholder="+7 999 123-45-67" class="qr-input" />
                                    </div>
                                    <div>
                                        <label for="input-sms-body" class="block text-sm font-semibold text-slate-700 mb-2">Текст сообщения</label>
                                        <textarea id="input-sms-body" rows="3" placeholder="Здравствуйте..." class="qr-input resize-none"></textarea>
                                    </div>
                                </div>
                            </div>

                            <p id="qr-input-msg" class="hidden mt-3 text-sm leading-relaxed" role="status"></p>
                        </div>

                        <div id="qr-preview-col" class="contents lg:block lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24 lg:self-start">
                        <div id="qr-mobile-bar">
                            <div id="qr-mobile-bar-row">
                            <button type="button" id="qr-preview-wrapper" class="bg-white border-2 border-slate-200 rounded-2xl p-5 flex items-center justify-center w-full aspect-square relative qr-preview-checker group cursor-zoom-in" aria-label="Открыть QR-код крупно">
                                <span id="qr-placeholder" class="text-center text-slate-400">
                                    <i class="fa-solid fa-qrcode text-5xl mb-3 opacity-30 max-lg:text-3xl max-lg:mb-0 block"></i>
                                    <span id="qr-placeholder-text" class="text-sm max-lg:hidden block">Введите данные — код появится сразу</span>
                                </span>
                                <canvas id="qr-canvas" class="hidden max-w-full max-h-full"></canvas>
                                <span class="qr-expand-badge" aria-hidden="true"><i class="fa-solid fa-expand"></i></span>
                                <span id="qr-scan-badge" class="hidden qr-scan-badge" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
                            </button>
                            <div id="qr-actions">
                            <div id="qr-readability-warning" class="hidden mt-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-2.5 text-sm text-amber-800 flex items-start gap-2 max-lg:!hidden">
                                <i class="fa-solid fa-triangle-exclamation mt-0.5 shrink-0"></i>
                                <span>Это фото может ухудшить читаемость QR-кода. Попробуйте фото с более тёмными тонами или загрузите другое.</span>
                            </div>
                            <div id="qr-scan-alerts" class="hidden mt-3 space-y-1.5 max-lg:!hidden"></div>

                            <div class="max-lg:hidden">
                                <div class="mt-4 flex items-center justify-between gap-2">
                                    <label for="input-export-size" class="text-xs font-medium text-slate-600">Размер PNG / JPG</label>
                                    <select id="input-export-size" class="qr-size-select">
                                        <option value="600">600 px — экран</option>
                                        <option value="1200" selected>1200 px — печать A5–A4</option>
                                        <option value="2000">2000 px — плакат</option>
                                    </select>
                                </div>
                                <div class="mt-2 grid grid-cols-3 gap-2">
